            "key": "application",
            "items": [
                {
                    "text": "This unit specifies the skills and knowledge required to carry out effective communication techniques underpinning work in the plumbing and services industry.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "application-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "In some jurisdictions, this unit of competency may form part of accreditation, licensing, legislative, regulatory or certification requirements.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "application-2",
                    "parent_bullet_item_id": null
                }
            ],
