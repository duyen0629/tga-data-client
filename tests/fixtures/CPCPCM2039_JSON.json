        {
            "key": "performance_evidence",
            "items": [
                {
                    "text": "To demonstrate competency, a candidate must meet the performance criteria for this unit by:",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "performance_evidence-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "communicating with others orally and non-verbally in a clear and accurate manner",
                    "type": "bullet",
                    "order": 2,
                    "indent": 0,
                    "item_id": "performance_evidence-2",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "reading and interpreting workplace procedures, job instructions, job processes and equipment and operator instructions",
                    "type": "bullet",
                    "order": 3,
                    "indent": 0,
                    "item_id": "performance_evidence-3",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "applying work activity signage in accordance with regulatory and workplace requirements",
                    "type": "bullet",
                    "order": 4,
                    "indent": 0,
                    "item_id": "performance_evidence-4",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "completing regulatory and workplace documentation.",
                    "type": "bullet",
                    "order": 5,
                    "indent": 0,
                    "item_id": "performance_evidence-5",
                    "parent_bullet_item_id": "performance_evidence-1"
                }
            ],
            "order": 9,
            "table": null,
            "title": "Performance Evidence"
        },
        {
            "key": "knowledge_evidence",
            "items": [
                {
                    "text": "To be competent in this unit, a candidate must demonstrate knowledge of:",
