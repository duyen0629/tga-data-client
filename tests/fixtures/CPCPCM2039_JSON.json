                    "item_id": "knowledge_evidence-2",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "non-verbal communication",
                    "type": "bullet",
                    "order": 3,
                    "indent": 0,
                    "item_id": "knowledge_evidence-3",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "standardised signage",
                    "type": "bullet",
                    "order": 4,
                    "indent": 0,
                    "item_id": "knowledge_evidence-4",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "visual signalling procedures",
                    "type": "bullet",
                    "order": 5,
                    "indent": 0,
                    "item_id": "knowledge_evidence-5",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "types of workplace documentation",
                    "type": "bullet",
                    "order": 6,
                    "indent": 0,
                    "item_id": "knowledge_evidence-6",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "how instructions are conveyed in the workplace",
                    "type": "bullet",
                    "order": 7,
                    "indent": 0,
                    "item_id": "knowledge_evidence-7",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "how work schedules, charts, bulletins and memos are used",
                    "type": "bullet",
                    "order": 8,
                    "indent": 0,
                    "item_id": "knowledge_evidence-8",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
