        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 5,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Identify information and/or instructions to be communicated and received."
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Identify workplace context and personnel with whom to communicate."
                            },
                            {
                                "id": "criteria-1_3",
                                "text": "1.3 Identify and select suitable forms of communication and method(s) for workplace context."
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Plan workplace communication."
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Communicate clearly and orally using language and method consistent with workplace context and procedures."
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Adjust oral communication delivery where intent of communication was not received correctly."
                            },
                            {
                                "id": "criteria-2_3",
                                "text": "2.3 Confirm communication is received by recipient as intended."
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Apply oral communication."
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Communicate non-verbally using body language and gestures consistent with workplace context and procedures."
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Adjust non-verbal communication delivery where intent of communication was not received correctly."
                            },
                            {
                                "id": "criteria-3_3",
                                "text": "3.3 Use visual communication that follows accepted industry practice or social convention in accordance with workplace context and procedures."
                            },
                            {
                                "id": "criteria-3_4",
                                "text": "3.4 Confirm communications are received by recipient as intended."
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Apply non-verbal communication."
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-4_1",
                                "text": "4.1 Identify workplace activities requiring written communication to be applied."
                            },
                            {
                                "id": "criteria-4_2",
                                "text": "4.2 Read and interpret workplace information or requirements from relevant job plans and specifications, codes, Australian standards, manufacturer’s specifications and jurisdictional requirements."
                            },
                            {
                                "id": "criteria-4_3",
                                "text": "4.3 Identify and apply regulatory and work activity signage in accordance with workplace procedures."
                            },
                            {
                                "id": "criteria-4_4",
                                "text": "4.4 Complete regulatory authorities' and workplace documentation in accordance with workplace procedures."
                            },
                            {
                                "id": "criteria-4_5",
                                "text": "4.5 Record and report work activities in accordance with workplace procedures."
                            }
                        ],
                        "element_id": "element-4",
                        "element_text": "4 Use written communication."
                    }
                ],
                "order": null,
                "columns": [
                    "Element",
                    "Performance Criteria"
                ]
            },
            "title": "Elements and Performance Criteria"
        },
