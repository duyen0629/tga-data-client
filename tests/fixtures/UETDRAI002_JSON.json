    "sections": [
        {
            "key": "modification_history",
            "items": [
                {
                    "text": "Release 1. This is the first release of this unit of competency in the UET Transmission, Distribution and Rail Sector Training Package Release 2.0.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "modification_history-1",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 1,
            "table": null,
            "title": "Modification History"
        },
        {
            "key": "application",
            "items": [
                {
                    "text": "This unit involves the skills and knowledge required to inspect poles, hardware and electrical apparatus in the electricity supply industry (ESI).",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "application-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "It includes visual inspection of poles above ground, overhead conductors and/or cables, underground and overhead transition points, pole-mounted transformers, switchgear, hardware and/or earthing systems.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "application-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "It also includes identifying and reporting defects.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "application-3",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "The application of the skills and knowledge described in this unit may require a licence/registration to practice in the workplace.",
                    "type": "paragraph",
                    "order": 4,
                    "indent": null,
                    "item_id": "application-4",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Other conditions may also apply under state and territory legislative and regulatory licensing requirements which must be confirmed prior to commencing this unit.",
                    "type": "paragraph",
                    "order": 5,
                    "indent": null,
                    "item_id": "application-5",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 2,
            "table": null,
            "title": "Application"
        },
