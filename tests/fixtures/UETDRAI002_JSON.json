        {
            "key": "assessment_conditions",
            "items": [
                {
                    "text": "Assessors must hold credentials specified within the Standards for Registered Training Organisations current at the time of assessment.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "assessment_conditions-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Assessment must satisfy the Principles of Assessment and Rules of Evidence and all regulatory requirements included within the Standards for Registered Training Organisations current at the time of assessment.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "assessment_conditions-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Assessment must occur in workplace operational situations, where it is appropriate to do so.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "assessment_conditions-3",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Where this is not appropriate, assessment must occur in simulated conditions involving realistic and authentic activities that replicate operational workplace conditions.",
                    "type": "paragraph",
                    "order": 4,
                    "indent": null,
                    "item_id": "assessment_conditions-4",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Assessment processes and techniques must be appropriate to the language, literacy and numeracy requirements of the work being performed and the needs of the candidate.",
                    "type": "paragraph",
                    "order": 5,
                    "indent": null,
                    "item_id": "assessment_conditions-5",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Resources for assessment must include access to:",
                    "type": "paragraph",
                    "order": 6,
                    "indent": null,
                    "item_id": "assessment_conditions-6",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "relevant and appropriate materials, tools, facilities, equipment and PPE currently used in industry for inspecting poles, hardware and electrical apparatus",
                    "type": "bullet",
                    "order": 7,
                    "indent": 0,
                    "item_id": "assessment_conditions-7",
                    "parent_bullet_item_id": "assessment_conditions-6"
                },
                {
                    "text": "applicable documentation, including workplace requirements, relevant industry standards, equipment specifications, regulations, codes of practice and operation manuals.",
                    "type": "bullet",
                    "order": 8,
                    "indent": 0,
                    "item_id": "assessment_conditions-8",
                    "parent_bullet_item_id": "assessment_conditions-6"
                }
            ],
            "order": 13,
            "table": null,
            "title": "Assessment Conditions"
