        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 9,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Review work instructions to apply paint by brush and roller."
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Plan all work to meet relevant requirements of work health and safety (WHS), Commonwealth and state or territory legislation, environmental plans and obligations, manufacturers’ specifications, and workplace requirements."
                            },
                            {
                                "id": "criteria-1_3",
                                "text": "1.3 Conduct work with regard to responsibilities in heritage-listed buildings."
                            },
                            {
                                "id": "criteria-1_4",
                                "text": "1.4 Select and fit personal protective equipment (PPE) as required for each task."
                            },
                            {
                                "id": "criteria-1_5",
                                "text": "1.5 Inspect work site, assess hazards and apply risk controls, including required signage and barricades."
                            },
                            {
                                "id": "criteria-1_6",
                                "text": "1.6 Identify materials appropriate to the work application, calculate quantities and prepare, handle safely and locate ready for use."
                            },
                            {
                                "id": "criteria-1_7",
                                "text": "1.7 Select tools and equipment, check for serviceability and report any faults."
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Plan and prepare."
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Check that materials and substrate surfaces are prepared in accordance with manufacturers’ recommendations and relevant Australian Standards."
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Protect surrounding surfaces with drop sheets, masking or removal of objects."
                            },
                            {
                                "id": "criteria-2_3",
                                "text": "2.3 Check that where doors, windows and associated furniture are removed they are safely stacked, stored and protected."
                            },
                            {
                                "id": "criteria-2_4",
                                "text": "2.4 Check work site to ensure provision of adequate ventilation and implementation of precautions to prevent fire and explosion."
                            },
                            {
                                "id": "criteria-2_5",
                                "text": "2.5 Implement measures to ensure application area remains free of dust and foreign matter."
                            },
                            {
                                "id": "criteria-2_6",
                                "text": "2.6 Mix each of oil based, water based and two pack paint, to designed proportion, consistency, specified ratio and drying time."
                            },
                            {
                                "id": "criteria-2_7",
                                "text": "2.7 Stir paint and colours thoroughly using separate stirring sticks or other devices."
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Prepare work area and materials."
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Select brush, roller or brush/roller combination for surface profile, size of area, type of paint and finish."
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Apply paint to achieve required level of opacity, finish, texture and sheen."
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Apply paint with brush or roller."
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-4_1",
                                "text": "4.1 Clean up, meeting all legislative and workplace requirements for safety, waste disposal, materials handling and protection of the environment."
                            },
                            {
                                "id": "criteria-4_2",
                                "text": "4.2 Clear work area, reuse or recycle materials and place waste and unwanted materials into job waste bins or rubbish stockpile."
                            },
                            {
                                "id": "criteria-4_3",
                                "text": "4.3 Check and maintain tools and equipment and clean with appropriate solvents."
                            },
                            {
                                "id": "criteria-4_4",
                                "text": "4.4 Dispose of paint waste and water and solvents used in cleaning painting equipment in an environmentally sustainable manner."
                            },
                            {
                                "id": "criteria-4_5",
                                "text": "4.5 Store tools, equipment and sealed unused materials to avoid spontaneous ignition."
                            }
                        ],
                        "element_id": "element-4",
                        "element_text": "4 Clean up."
                    }
                ],
                "order": null,
                "columns": [
                    "Element",
                    "Performance Criteria"
                ]
            },
            "title": "Elements and Performance Criteria"
        },
