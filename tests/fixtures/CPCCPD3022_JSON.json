        {
            "key": "application",
            "items": [
                {
                    "text": "This unit of competency specifies the skills and knowledge required to apply brushed or rolled paint coatings to different materials to form a protective and decorative painted finish.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "application-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "The unit includes preparation of the work area, mixing of materials, application of paint, finishing of the surface and completion of clean-up activities.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "application-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "A person who has achieved this unit of competency would be expected to take responsibility for organising and completing these tasks with a high degree of self direction.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "application-3",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Completion of the general construction induction training program specified by the model Code of Practice for Construction Work is required for any person who is to carry out construction work. Achievement of CPCWHS1001Prepare to work safely in the construction industrymeets this requirement.",
                    "type": "paragraph",
                    "order": 4,
                    "indent": null,
                    "item_id": "application-4",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "No licensing, legislative or certification requirements apply to this unit at the time of publication.",
                    "type": "paragraph",
                    "order": 5,
                    "indent": null,
                    "item_id": "application-5",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 6,
            "table": null,
            "title": "Application"
        },
