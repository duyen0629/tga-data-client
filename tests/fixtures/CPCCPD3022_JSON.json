        {
            "key": "performance_evidence",
            "items": [
                {
                    "text": "To demonstrate competency, a candidate must meet the performance criteria of this unit by applying paint finishes by brush, roller or a brush roller combination to a range of surfaces, including:",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "performance_evidence-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "one room, at a minimum of three metres by three metres, including the ceiling",
                    "type": "bullet",
                    "order": 2,
                    "indent": 0,
                    "item_id": "performance_evidence-2",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "a timber panel door:",
                    "type": "bullet",
                    "order": 3,
                    "indent": 0,
                    "item_id": "performance_evidence-3",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "one oil based application",
                    "type": "bullet",
                    "order": 4,
                    "indent": 1,
                    "item_id": "performance_evidence-4",
                    "parent_bullet_item_id": "performance_evidence-3"
                },
                {
                    "text": "one water based application",
                    "type": "bullet",
                    "order": 5,
                    "indent": 1,
                    "item_id": "performance_evidence-5",
                    "parent_bullet_item_id": "performance_evidence-3"
                },
                {
                    "text": "a flush door:",
                    "type": "bullet",
                    "order": 6,
                    "indent": 0,
                    "item_id": "performance_evidence-6",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "one oil based application",
                    "type": "bullet",
                    "order": 7,
                    "indent": 1,
                    "item_id": "performance_evidence-7",
                    "parent_bullet_item_id": "performance_evidence-6"
                },
                {
                    "text": "one water based application",
                    "type": "bullet",
                    "order": 8,
                    "indent": 1,
                    "item_id": "performance_evidence-8",
                    "parent_bullet_item_id": "performance_evidence-6"
                },
                {
                    "text": "a timber window, including architrave and frame with moving parts (e.g. box frame, hopper and awning)",
                    "type": "bullet",
                    "order": 9,
                    "indent": 0,
                    "item_id": "performance_evidence-9",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "a timber surface to minimum of one square metre using two pack.",
                    "type": "bullet",
                    "order": 10,
                    "indent": 0,
                    "item_id": "performance_evidence-10",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "All finishes must be to specification, including in terms of defects, thickness, sheen, opacity, colour and sharpness.",
                    "type": "paragraph",
                    "order": 11,
                    "indent": null,
                    "item_id": "performance_evidence-11",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "All work must be performed to the standard required in the workplace and must meet the requirements of work health and safety (WHS), Commonwealth and state or territory legislation, manufacturers’ specifications, and environmental plans and obligations.",
                    "type": "paragraph",
                    "order": 12,
                    "indent": null,
                    "item_id": "performance_evidence-12",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 2,
            "table": null,
            "title": "Performance Evidence"
        },
