        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 9,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Read and interpret relevant information to identify and use stone products from specifications, standards and codes."
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Interpret and follow relevant information from workplace safety and environmental documentation and workplace procedures."
                            },
                            {
                                "id": "criteria-1_3",
                                "text": "1.3 Clarify job priorities and sequence job tasks in consultation with others on site."
                            },
                            {
                                "id": "criteria-1_4",
                                "text": "1.4 Identify potential hazards and implement control measures."
                            },
                            {
                                "id": "criteria-1_5",
                                "text": "1.5 Select and check condition of plant, equipment and tools and report damage or faults to relevant person."
                            },
                            {
                                "id": "criteria-1_6",
                                "text": "1.6 Check conformity of materials against the job requirements."
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Plan and prepare."
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Identify and match architectural styles, natural and manufactured stone and functions of stone products to job specifications."
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Identify sources of stone and manufacturing and quarrying techniques for production of natural and manufactured stone."
                            },
                            {
                                "id": "criteria-2_3",
                                "text": "2.3 Identify key features and patterns in stone."
                            },
                            {
                                "id": "criteria-2_4",
                                "text": "2.4 Identify defects in stone and the effect on their functions."
                            },
                            {
                                "id": "criteria-2_5",
                                "text": "2.5 Identify methods, processes and plant and tools used to manufacture stone products."
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Identify types and characteristics of stone."
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Select, fit correctly and use personal protective equipment (PPE) appropriate for job."
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Apply manual handling techniques when positioning stone on cutting machine."
                            },
                            {
                                "id": "criteria-3_3",
                                "text": "3.3 Secure stone, align cuts and operate equipment and tools to saw stone."
                            },
                            {
                                "id": "criteria-3_4",
                                "text": "3.4 Cut stone to size and design and take measures to minimise silica dust."
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Saw stone"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-4_1",
                                "text": "4.1 Clear the work area, and dispose of, reuse or recycle materials following workplace and environment requirements."
                            },
                            {
                                "id": "criteria-4_2",
                                "text": "4.2 Clean tools and equipment, check for serviceability and report damage or faults."
                            },
                            {
                                "id": "criteria-4_3",
                                "text": "4.3 Store and secure tools and equipment following workplace procedures."
                            }
                        ],
                        "element_id": "element-4",
                        "element_text": "4 Clean up."
                    }
                ],
                "order": null,
                "columns": [
                    "Element",
                    "Performance Criteria"
                ]
            },
            "title": "Elements and Performance Criteria"
        },
