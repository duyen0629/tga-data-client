        {
            "key": "application",
            "items": [
                {
                    "text": "This unit specifies the skills and knowledge required to identify, select and cut suitable natural stone for both off-site and in situ installation.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "application-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "This unit is suitable for people with basic skills and knowledge who undertake routine stonemasonry work tasks under the direction of more experienced workers.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "application-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Completion of the general construction induction training program specified by the model Code of Practice for Construction Work is required for any person who is to carry out construction work. Achievement of CPCWHS1001Prepare to work safely in the construction industrymeets this requirement.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "application-3",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "No licensing, legislative or certification requirements apply to this unit at the time of publication.",
                    "type": "paragraph",
                    "order": 4,
                    "indent": null,
                    "item_id": "application-4",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 6,
            "table": null,
            "title": "Application"
        },
