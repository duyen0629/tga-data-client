                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "assessment_conditions-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "This unit must be assessed in the workplace or a close simulation reflecting workplace conditions and standards, materials, equipment, activities, responsibilities, procedures, safety requirements and environmental considerations.",
