        {
            "key": "performance_evidence",
            "items": [
                {
                    "text": "To demonstrate competency in this unit, a candidate must meet the performance criteria of this unit by cutting three types of stone to different sizes and shapes.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "performance_evidence-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "In doing this, the candidate must:",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "performance_evidence-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "use three different methods to cut:",
                    "type": "bullet",
                    "order": 3,
                    "indent": 0,
                    "item_id": "performance_evidence-3",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "one igneous stone",
                    "type": "bullet",
                    "order": 4,
                    "indent": 1,
                    "item_id": "performance_evidence-4",
                    "parent_bullet_item_id": "performance_evidence-3"
                },
                {
                    "text": "one metamorphic stone",
                    "type": "bullet",
                    "order": 5,
                    "indent": 1,
                    "item_id": "performance_evidence-5",
                    "parent_bullet_item_id": "performance_evidence-3"
                },
                {
                    "text": "one sedimentary stone.",
                    "type": "bullet",
                    "order": 6,
                    "indent": 1,
                    "item_id": "performance_evidence-6",
                    "parent_bullet_item_id": "performance_evidence-3"
                }
            ],
            "order": 2,
            "table": null,
            "title": "Performance Evidence"
        },
