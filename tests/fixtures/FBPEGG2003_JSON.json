        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 5,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Identify key work locations and egg grading and packaging equipment on egg grading floor"
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Identify grades of eggs packed by the workplace"
                            },
                            {
                                "id": "criteria-1_3",
                                "text": "1.3 Identify trays and packaging used for all orders, and location of best before dates on trays and cartons"
                            },
                            {
                                "id": "criteria-1_4",
                                "text": "1.4 Identify storage locations for packed orders prior to dispatch"
                            },
                            {
                                "id": "criteria-1_5",
                                "text": "1.5 Identify safe work procedures for egg grading, including use of personal protective equipment"
                            },
                            {
                                "id": "criteria-1_6",
                                "text": "1.6 Identify workplace environmental guidelines for egg grading floor operations, including disposal of waste"
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Prepare for egg grading operation"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Identify different grades of fresh eggs, including by size"
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Recognise gross, hairline and star cracks, black rot, dirt and other faults in eggs"
                            },
                            {
                                "id": "criteria-2_3",
                                "text": "2.3 Identify defects though the candling process"
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Recognise egg grades and common egg faults"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Confirm method for egg cleaning"
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Identify key risks to food safety on egg grading floor, including food safety plan and egg grading floor critical control points"
                            },
                            {
                                "id": "criteria-3_3",
                                "text": "3.3 Confirm steps and locations for detecting eggs with gross defects"
                            },
                            {
                                "id": "criteria-3_4",
                                "text": "3.4 Identify quality system, including sampling program and tests conducted both on and off the grading floor"
                            },
                            {
                                "id": "criteria-3_5",
                                "text": "3.5 Ensure eggs are individually stamped in line with Food Standards requirements"
                            },
                            {
                                "id": "criteria-3_6",
                                "text": "3.6 Identify and confirm steps and requirements for the packaging process, including process for printing best before date"
                            },
                            {
                                "id": "criteria-3_7",
                                "text": "3.7 Confirm temperature and humidity requirements for storing eggs"
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Operate on the egg grading floor"
                    }
                ],
                "order": null,
                "columns": [
                    "Element",
                    "Performance Criteria"
                ]
            },
            "title": "Elements and Performance Criteria"
        },
