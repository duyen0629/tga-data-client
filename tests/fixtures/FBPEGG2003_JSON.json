        {
            "key": "application",
            "items": [
                {
                    "text": "This unit of competency describes the skills and knowledge required to grade eggs, which requires knowledge of basic egg characteristics and quality principles in egg production and packing.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "application-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "This unit applies to individuals who work in egg grading and packing facilities in a poultry production environment in either an operations or quality role.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "application-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "All work must be carried out to comply with workplace procedures, in accordance with state/territory health and safety and food safety regulations, legislation and standards that apply to the workplace.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "application-3",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "No licensing, legislative or certification requirements apply to this unit at the time of publication.",
                    "type": "paragraph",
                    "order": 4,
                    "indent": null,
                    "item_id": "application-4",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 2,
            "table": null,
            "title": "Application"
        },
