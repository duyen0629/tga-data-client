        {
            "key": "performance_evidence",
            "items": [
                {
                    "text": "An individual demonstrating competency must satisfy all of the elements and performance criteria in this unit.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "performance_evidence-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "There must be evidence that the individual has worked on an egg grading floor to grade eggs over a period of one shift, including:",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "performance_evidence-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "identifying and addressing food safety risks",
                    "type": "bullet",
                    "order": 3,
                    "indent": 0,
                    "item_id": "performance_evidence-3",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "recognising eggs faults",
                    "type": "bullet",
                    "order": 4,
                    "indent": 0,
                    "item_id": "performance_evidence-4",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "ensuring eggs are stamped and washed in line with food safety standards.",
                    "type": "bullet",
                    "order": 5,
                    "indent": 0,
                    "item_id": "performance_evidence-5",
                    "parent_bullet_item_id": "performance_evidence-2"
                }
            ],
            "order": 9,
            "table": null,
            "title": "Performance Evidence"
        },
        {
            "key": "knowledge_evidence",
            "items": [
                {
                    "text": "An individual must be able to demonstrate the knowledge required to perform the tasks outlined in the elements and performance criteria of this unit. This includes knowledge of:",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "knowledge_evidence-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "functions of key work areas, including washing equipment, weighing and automatic fault detection equipment, lanes, denesters, backpack side, quality room and cool rooms",
                    "type": "bullet",
                    "order": 2,
                    "indent": 0,
                    "item_id": "knowledge_evidence-2",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "egg components and purpose, including shell, shell membranes, yolk, albumen and air cell",
                    "type": "bullet",
                    "order": 3,
                    "indent": 0,
                    "item_id": "knowledge_evidence-3",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "Food Standards Code requirements for eggs and egg products",
                    "type": "bullet",
                    "order": 4,
                    "indent": 0,
                    "item_id": "knowledge_evidence-4",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "commonalities and differences between egg grades",
                    "type": "bullet",
                    "order": 5,
                    "indent": 0,
                    "item_id": "knowledge_evidence-5",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "importance of early grading and packing eggs on freshness",
                    "type": "bullet",
                    "order": 6,
                    "indent": 0,
                    "item_id": "knowledge_evidence-6",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "purpose and methods for egg cleaning",
                    "type": "bullet",
                    "order": 7,
                    "indent": 0,
                    "item_id": "knowledge_evidence-7",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "the need to separate dirty/unwashed eggs from clean/washed eggs",
                    "type": "bullet",
                    "order": 8,
                    "indent": 0,
                    "item_id": "knowledge_evidence-8",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "key egg faults, including types of cracks, faulty colouring, faulty shapes, and blood and other inclusions, and the methods used to detect faults",
                    "type": "bullet",
                    "order": 9,
                    "indent": 0,
                    "item_id": "knowledge_evidence-9",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "contamination and foreign bodies likely to be present in eggs and egg products",
                    "type": "bullet",
                    "order": 10,
                    "indent": 0,
                    "item_id": "knowledge_evidence-10",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "food safety risks present in egg pulp and egg products, including biological, chemical, physical and allergenic risks",
                    "type": "bullet",
                    "order": 11,
                    "indent": 0,
                    "item_id": "knowledge_evidence-11",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "measures used to control food safety risks",
                    "type": "bullet",
                    "order": 12,
                    "indent": 0,
                    "item_id": "knowledge_evidence-12",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "temperature and humidity requirements for storing eggs, and effects of variation from these requirements",
                    "type": "bullet",
                    "order": 13,
                    "indent": 0,
                    "item_id": "knowledge_evidence-13",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "environmental issues and controls relevant to the process, including waste or rework collection and handling procedures related to the process",
                    "type": "bullet",
                    "order": 14,
                    "indent": 0,
                    "item_id": "knowledge_evidence-14",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "health and safety procedures for egg grading, including the use of personal protective equipment",
                    "type": "bullet",
                    "order": 15,
                    "indent": 0,
                    "item_id": "knowledge_evidence-15",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "workplace cleaning and sanitisation procedures relevant to the egg grading process",
                    "type": "bullet",
                    "order": 16,
                    "indent": 0,
                    "item_id": "knowledge_evidence-16",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "procedures to record traceability of product.",
                    "type": "bullet",
                    "order": 17,
                    "indent": 0,
                    "item_id": "knowledge_evidence-17",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                }
            ],
            "order": 10,
            "table": null,
            "title": "Knowledge Evidence"
        },
