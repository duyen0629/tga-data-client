        {
            "key": "performance_evidence",
            "items": [
                {
                    "text": "The candidate must demonstrate the ability to complete the tasks outlined in the elements, performance criteria and foundation skills of this unit, including evidence of the ability to:",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "performance_evidence-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "develop and present a business proposal for a product or service.",
                    "type": "bullet",
                    "order": 2,
                    "indent": 0,
                    "item_id": "performance_evidence-2",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "In the course of the above, the candidate must:",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "performance_evidence-3",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "analyse information from a range of sources to evaluate the viability of the business opportunities, including:",
                    "type": "bullet",
                    "order": 4,
                    "indent": 0,
                    "item_id": "performance_evidence-4",
                    "parent_bullet_item_id": "performance_evidence-3"
                },
                {
                    "text": "consideration of personal commitments",
                    "type": "bullet",
                    "order": 5,
                    "indent": 1,
                    "item_id": "performance_evidence-5",
                    "parent_bullet_item_id": "performance_evidence-4"
                },
                {
                    "text": "risk identification and assessment",
                    "type": "bullet",
                    "order": 6,
                    "indent": 1,
                    "item_id": "performance_evidence-6",
                    "parent_bullet_item_id": "performance_evidence-4"
                },
                {
                    "text": "personal skills and attributes analysis against required skills",
                    "type": "bullet",
                    "order": 7,
                    "indent": 1,
                    "item_id": "performance_evidence-7",
                    "parent_bullet_item_id": "performance_evidence-4"
                },
                {
                    "text": "anticipated financial returns.",
                    "type": "bullet",
                    "order": 8,
                    "indent": 1,
                    "item_id": "performance_evidence-8",
                    "parent_bullet_item_id": "performance_evidence-4"
                }
            ],
            "order": 8,
            "table": null,
            "title": "Performance Evidence"
        },
