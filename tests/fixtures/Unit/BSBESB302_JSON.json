        {
            "key": "application",
            "items": [
                {
                    "text": "This unit describes the skills and knowledge required to research the viability of ideas for business opportunities and develop and present proposals for viable options in formats suiting a range of stakeholders.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "application-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "The unit applies to those establishing or operating a business providing self-employment, as well as those establishing a new venture as part of a larger organisation. The proposals may relate to products and/or services offered by the business.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "application-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "No licensing, legislative or certification requirements apply to this unit at the time of publication.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "application-3",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 2,
            "table": null,
            "title": "Application"
        },
        {
            "key": "unit_sector",
