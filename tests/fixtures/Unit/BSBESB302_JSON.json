        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 4,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Identify ideas relating to business opportunities"
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Research key factors influencing their financial viability"
                            },
                            {
                                "id": "criteria-1_3",
                                "text": "1.3 Analyse business ideas to determine viability of business opportunity"
                            },
                            {
                                "id": "criteria-1_4",
                                "text": "1.4 Record outcomes of evaluation according to workplace procedures"
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Evaluate business ideas"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Identify potential risks associated with opportunity ideas and viability of business"
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Communicate with relevant stakeholders the potential risks"
                            },
                            {
                                "id": "criteria-2_3",
                                "text": "2.3 Assist relevant stakeholders to develop risk management systems"
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Manage risk associated with business proposal"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Identify audience for proposal, and required structure and content"
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Establish budget according to financial viability"
                            },
                            {
                                "id": "criteria-3_3",
                                "text": "3.3 Develop description of business idea according to identified budget and business opportunities"
                            },
                            {
                                "id": "criteria-3_4",
                                "text": "3.4 Confirm that draft proposal meets requirements"
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Develop proposal for viable business idea"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-4_1",
                                "text": "4.1 Determine presentation method suited to audience"
                            },
                            {
                                "id": "criteria-4_2",
                                "text": "4.2 Provide customised business proposal to target audience"
                            },
                            {
                                "id": "criteria-4_3",
                                "text": "4.3 Seek feedback to inform future proposals"
                            }
                        ],
                        "element_id": "element-4",
                        "element_text": "4 Present business proposal"
                    }
                ],
                "order": null,
                "columns": [
                    "Element",
                    "Performance Criteria"
                ]
            },
            "title": "Elements and Performance Criteria"
        },
