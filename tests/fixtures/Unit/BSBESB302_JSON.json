                    "text": "workplace documentation and resources relevant to performance evidence",
                    "type": "bullet",
                    "order": 5,
                    "indent": 0,
                    "item_id": "assessment_conditions-5",
                    "parent_bullet_item_id": "assessment_conditions-2"
                },
                {
                    "text": "interaction with others for presentation purposes.",
                    "type": "bullet",
                    "order": 6,
                    "indent": 0,
                    "item_id": "assessment_conditions-6",
                    "parent_bullet_item_id": "assessment_conditions-2"
                },
                {
