        {
            "key": "application",
            "items": [
                {
                    "text": "This unit describes the skills and knowledge required to determine the specific legal and ethical requirements for marriage celebrancy practice, create and maintain systems and resources, and maintain and improve skills and knowledge in marriage celebrancy.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "application-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "This unit applies to individuals seeking to be registered as a Commonwealth-registered marriage celebrant by the Attorney-General’s Department.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "application-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "The skills in this unit must be applied in accordance with Commonwealth and State/Territory legislation, Australian/New Zealand Standards and industry codes of practice.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "application-3",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 2,
            "table": null,
            "title": "Application"
        },
        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 3,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Identify and access sources of authoritative information on the legal and ethical requirements for the establishment and maintenance of a marriage celebrancy practice"
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Review and collate current information that supports professional practice as a marriage celebrant"
                            },
                            {
                                "id": "criteria-1_3",
                                "text": "1.3 Identify systems and resources required to meet legal requirements from evaluation of information"
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Determine legal and ethical requirements for marriage celebrancy practice"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Organise resources required to support marriage celebrancy work"
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Create and document systems and procedures that support adherence to legal requirements and the Code of Practice for marriage celebrants"
                            },
                            {
                                "id": "criteria-2_3",
                                "text": "2.3 Ensure administrative systems and supplies are in place to support completion, storage and registration of relevant documentation in accordance with legal requirements"
                            },
                            {
                                "id": "criteria-2_4",
                                "text": "2.4 Seek guidance from authoritative sources on establishment of systems and resources"
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Create and maintain marriage celebrancy systems and resources"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Maintain currency of marriage celebrancy knowledge using authoritative information sources"
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Pro-actively identify and use professional development opportunities"
                            },
                            {
                                "id": "criteria-3_3",
                                "text": "3.3 Use feedback and reflection as the basis for practice improvement"
                            },
                            {
                                "id": "criteria-3_4",
                                "text": "3.4 Collaborate with colleagues as part of ongoing professional development"
                            },
                            {
                                "id": "criteria-3_5",
                                "text": "3.5 Integrate current and emerging ideas and technologies into own practice and resources"
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Maintain and improve own skills and resources"
                    }
                ],
                "order": null,
                "columns": [
                    "Element",
                    "Performance Criteria"
                ]
            },
            "title": "Elements and Performance Criteria"
        },
        {
            "key": "foundation_skills",
            "items": [
                {
                    "text": "The Foundation Skills describe those required skills (language, literacy, numeracy and employment skills) that are essential to performance.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "foundation_skills-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Foundation skills essential to performance are explicit in the performance criteria of this unit of competency.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "foundation_skills-2",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 4,
            "table": null,
            "title": "Foundation Skills"
        },
