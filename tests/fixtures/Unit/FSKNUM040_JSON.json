        {
            "key": "performance_evidence",
            "items": [
                {
                    "text": "The candidate must demonstrate the ability to complete the tasks outlined in the elements, performance criteria and foundation skills of this unit, including evidence of the ability to:",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "performance_evidence-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "describe everyday common workplace chance events, including:",
                    "type": "bullet",
                    "order": 2,
                    "indent": 0,
                    "item_id": "performance_evidence-2",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "interpreting and comparing the chance of at least two different everyday chance events",
                    "type": "bullet",
                    "order": 3,
                    "indent": 1,
                    "item_id": "performance_evidence-3",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "interpreting common workplace chance events in qualitative terms using informal and some formal mathematical language",
                    "type": "bullet",
                    "order": 4,
                    "indent": 1,
                    "item_id": "performance_evidence-4",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "interpreting common workplace chance events in terms of relative everyday common fractions, decimals and percentages.",
                    "type": "bullet",
                    "order": 5,
                    "indent": 1,
                    "item_id": "performance_evidence-5",
                    "parent_bullet_item_id": "performance_evidence-2"
                }
            ],
            "order": 8,
            "table": null,
            "title": "Performance Evidence"
        },
        {
            "key": "knowledge_evidence",
            "items": [
                {
                    "text": "The candidate must be able to demonstrate knowledge to complete the tasks outlined in the elements, performance criteria and foundation skills of this unit, including knowledge of:",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "knowledge_evidence-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "purpose and meaning of describing common workplace chance events",
                    "type": "bullet",
                    "order": 2,
                    "indent": 0,
                    "item_id": "knowledge_evidence-2",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "common everyday events relevant to workplace involving chance (e.g., chance of rain, chance of accidents, chance of random selection of a particular item)",
                    "type": "bullet",
                    "order": 3,
                    "indent": 0,
                    "item_id": "knowledge_evidence-3",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "meaning of common and everyday language and terminology used for describing common chance events in qualitative terms (e.g., certain, likely, impossible)",
                    "type": "bullet",
                    "order": 4,
                    "indent": 0,
                    "item_id": "knowledge_evidence-4",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "meaning of different chance events in quantitative terms in everyday fractions, decimals and percentages and relationship to qualitative terms",
                    "type": "bullet",
                    "order": 5,
                    "indent": 0,
                    "item_id": "knowledge_evidence-5",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "methods for using estimation and assessment skills to check and reflect on outcome and appropriateness to the workplace task",
                    "type": "bullet",
                    "order": 6,
                    "indent": 0,
                    "item_id": "knowledge_evidence-6",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "informal and some formal mathematical written and oral language and symbolism of chance.",
                    "type": "bullet",
                    "order": 7,
                    "indent": 0,
                    "item_id": "knowledge_evidence-7",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                }
            ],
            "order": 9,
            "table": null,
            "title": "Knowledge Evidence"
        },
        {
            "key": "assessment_conditions",
            "items": [
                {
                    "text": "Competency is to be assessed in the workplace, a workplace simulated environment or a vocational training context.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "assessment_conditions-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Assistive technologies can be utilised to assist with oral and written communication.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "assessment_conditions-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Skills must be demonstrated using routine texts and tasks that reflect those typically found in a workplace.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "assessment_conditions-3",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "The following resources are to be made available:",
                    "type": "paragraph",
                    "order": 4,
                    "indent": null,
                    "item_id": "assessment_conditions-4",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "a calculator",
                    "type": "bullet",
                    "order": 5,
                    "indent": 0,
                    "item_id": "assessment_conditions-5",
                    "parent_bullet_item_id": "assessment_conditions-4"
                },
                {
                    "text": "own familiar support resources.",
                    "type": "bullet",
                    "order": 6,
                    "indent": 0,
                    "item_id": "assessment_conditions-6",
                    "parent_bullet_item_id": "assessment_conditions-4"
                },
                {
                    "text": "Assessors must:",
                    "type": "paragraph",
                    "order": 7,
                    "indent": null,
                    "item_id": "assessment_conditions-7",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "satisfy the requirements for assessors in applicable vocational education and training legislation, frameworks and/or standards, and",
                    "type": "bullet",
                    "order": 8,
                    "indent": 0,
                    "item_id": "assessment_conditions-8",
                    "parent_bullet_item_id": "assessment_conditions-7"
                },
                {
                    "text": "have sound knowledge of the ACSF and performance features of the ACSF level being assessed, and",
                    "type": "bullet",
                    "order": 9,
                    "indent": 0,
                    "item_id": "assessment_conditions-9",
                    "parent_bullet_item_id": "assessment_conditions-7"
                },
                {
                    "text": "have demonstrable expertise, knowledge and skills in the vocational contextualisation and assessment of the core skill, numeracy, and",
                    "type": "bullet",
                    "order": 10,
                    "indent": 0,
                    "item_id": "assessment_conditions-10",
                    "parent_bullet_item_id": "assessment_conditions-7"
                },
                {
                    "text": "have completed the following or equivalent:",
                    "type": "bullet",
                    "order": 11,
                    "indent": 0,
                    "item_id": "assessment_conditions-11",
                    "parent_bullet_item_id": "assessment_conditions-7"
                },
                {
                    "text": "TAESS00009 Address Foundation Skills in Vocational Practice Skill Set; or",
                    "type": "bullet",
                    "order": 12,
                    "indent": 1,
                    "item_id": "assessment_conditions-12",
                    "parent_bullet_item_id": "assessment_conditions-11"
                },
                {
                    "text": "a higher level education qualification, such as:",
                    "type": "bullet",
                    "order": 13,
                    "indent": 1,
                    "item_id": "assessment_conditions-13",
                    "parent_bullet_item_id": "assessment_conditions-11"
                },
                {
                    "text": "TAE80113Graduate Diploma of Adult Language, Literacy and Numeracy Practice (and its equivalent TAE70111); or",
                    "type": "bullet",
                    "order": 14,
                    "indent": 2,
                    "item_id": "assessment_conditions-14",
                    "parent_bullet_item_id": "assessment_conditions-13"
                },
                {
                    "text": "Bachelor of Education,Graduate Certificate or Graduate Diploma of Education, or higher. This may include qualifications relating to TESOL, adult education or vocational education.",
                    "type": "bullet",
                    "order": 15,
                    "indent": 2,
                    "item_id": "assessment_conditions-15",
                    "parent_bullet_item_id": "assessment_conditions-13"
                }
            ],
            "order": 10,
            "table": null,
            "title": "Assessment Conditions"
        }
    ]
