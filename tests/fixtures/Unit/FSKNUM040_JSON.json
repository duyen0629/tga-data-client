        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 4,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Identify and interpret everyday chance event information partially embedded in familiar oral workplace tasks and texts"
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Identify and interpret everyday chance event information partially embedded in familiar and simple written workplace tasks and texts"
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Identify and interpret common chance information"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Identify everyday common workplace task/event relevant to the interpretation of chance"
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Interpret the likelihood of the chance event(s) occurring using qualitative terms"
                            },
                            {
                                "id": "criteria-2_3",
                                "text": "2.3 Relate qualitative terms to everyday, routine fractions, decimals and percentages"
                            },
                            {
                                "id": "criteria-2_4",
                                "text": "2.4 Compare likelihood of the everyday common chance event with other similar occurrences at different times, places or under different conditions and identify implications for workplace"
                            },
                            {
                                "id": "criteria-2_5",
                                "text": "2.5 Check and reflect on interpretation and comparison of chance event and appropriateness of outcome to workplace task"
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Interpret and compare common chance events"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Use informal and formal written mathematical representation to document and report on chance event and problem solving process and results"
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Use informal and formal mathematical language to present and discuss chance event and problem solving process and results"
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Communicate chance information"
                    }
                ],
                "order": null,
                "columns": [
                    "Element",
                    "Performance Criteria"
                ]
            },
            "title": "Elements and Performance Criteria"
        },
        {
            "key": "foundation_skills",
            "items": [
