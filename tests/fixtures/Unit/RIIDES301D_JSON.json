        {
            "key": "application",
            "items": [
                {
                    "text": "This unit describes a participant’s skills and knowledge required to inspect, test and maintain diesel engine systems and their ancillary systems in Coal mining.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "application-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "This unit is appropriate for those working in operational roles.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "application-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Licensing, legislative, regulatory and certification requirements that apply to this unit can vary between states, territories, and Industry sectors. Relevant information must be sourced prior to application of this unit.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "application-3",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 6,
            "table": null,
            "title": "Application"
        },
