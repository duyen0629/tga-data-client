        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 8,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Access, interpret, inspect, test and maintain diesel engine systems and their ancillary systems, apply documentation and ensure the work activity is compliant"
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Obtain, interpret, clarify, confirm and apply verbal and written work instructions"
                            },
                            {
                                "id": "criteria-1_3",
                                "text": "1.3 Conduct a toolbox talk with others at the site prior to commencing and during work activities"
                            },
                            {
                                "id": "criteria-1_4",
                                "text": "1.4 Identify, address and report potential hazards, risks and environmental issues and implement control measures"
                            },
                            {
                                "id": "criteria-1_5",
                                "text": "1.5 Obtain and interpret emergency procedures, and be prepared for an emergency"
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Plan for inspection, testing and maintenance of diesel engine systems and their ancillary systems"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Coordinate activities with others prior to commencement of, during, and on completion of the work activity"
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Identify and obtain items and tools required for the safe, effective and efficient completion of the tasks"
                            },
                            {
                                "id": "criteria-2_3",
                                "text": "2.3 Select and wear personal protection equipment appropriate for work activities"
                            },
                            {
                                "id": "criteria-2_4",
                                "text": "2.4 Access, interpret and apply equipment pre-start procedures"
                            },
                            {
                                "id": "criteria-2_5",
                                "text": "2.5 Access and apply isolation and lock-out of all equipment"
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Prepare for inspection, testing and maintenance of diesel engine systems and their ancillary systems"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Inspect diesel engine systems and their ancillary systems"
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Report outcomes of inspection to appropriate person"
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Carry out inspection of diesel engines and their ancillary systems"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-4_1",
                                "text": "4.1 Access and operate testing equipment"
                            },
                            {
                                "id": "criteria-4_2",
                                "text": "4.2 Carry out safe, effective and efficient testing and fault finding of diesel engine and ancillary systems"
                            },
                            {
                                "id": "criteria-4_3",
                                "text": "4.3 Diagnose and record existing or identified faults and recommend corrective actions"
                            }
                        ],
                        "element_id": "element-4",
                        "element_text": "4 Carry out testing of diesel engines and their ancillary systems"
                    },
