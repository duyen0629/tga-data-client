        },
        {
            "key": "assessment_conditions",
            "items": [
                {
                    "text": "Assessors must satisfy relevant vocational education and training legislation, frameworks and/or standards.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "assessment_conditions-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Assessment must occur in workplace operational situations. Where this is not appropriate, assessment must occur in simulated workplace operational situations that replicate workplace conditions.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "assessment_conditions-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Assessment processes and techniques must be appropriate to the language, literacy and numeracy requirements of the work being performed and the needs of the candidate.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "assessment_conditions-3",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Resources for assessment must include access to:",
                    "type": "paragraph",
                    "order": 4,
                    "indent": null,
                    "item_id": "assessment_conditions-4",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "a range of relevant exercises, case studies and/or simulations",
                    "type": "bullet",
                    "order": 5,
                    "indent": 0,
                    "item_id": "assessment_conditions-5",
                    "parent_bullet_item_id": "assessment_conditions-4"
                },
                {
                    "text": "acceptable means of simulation assessment",
                    "type": "bullet",
                    "order": 6,
                    "indent": 0,
                    "item_id": "assessment_conditions-6",
                    "parent_bullet_item_id": "assessment_conditions-4"
                },
                {
                    "text": "relevant and appropriate materials, tools, equipment and personal protective equipment currently used in industry",
                    "type": "bullet",
                    "order": 7,
                    "indent": 0,
                    "item_id": "assessment_conditions-7",
                    "parent_bullet_item_id": "assessment_conditions-4"
                },
                {
                    "text": "relevant standards, policy and instructions related to public affairs",
                    "type": "bullet",
                    "order": 8,
                    "indent": 0,
                    "item_id": "assessment_conditions-8",
                    "parent_bullet_item_id": "assessment_conditions-4"
                },
                {
                    "text": "applicable documentation, including operational procedures, regulations, codes of practice and operation manuals.",
                    "type": "bullet",
                    "order": 9,
                    "indent": 0,
                    "item_id": "assessment_conditions-9",
                    "parent_bullet_item_id": "assessment_conditions-4"
                }
            ],
            "order": 4,
            "table": null,
            "title": "Assessment Conditions"
        },
