        {
            "key": "application",
            "items": [
                {
                    "text": "This unit specifies the skills and knowledge required to manage public affairs projects.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "application-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "It includes defining project scope, developing an overall project plan, monitoring the project and evaluating planned outcomes.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "application-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "The project may include:",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "application-3",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "video/film productions",
                    "type": "bullet",
                    "order": 4,
                    "indent": 0,
                    "item_id": "application-4",
                    "parent_bullet_item_id": "application-3"
                },
                {
                    "text": "radio productions, drama documentaries",
                    "type": "bullet",
                    "order": 5,
                    "indent": 0,
                    "item_id": "application-5",
                    "parent_bullet_item_id": "application-3"
                },
                {
                    "text": "multimedia projects",
                    "type": "bullet",
                    "order": 6,
                    "indent": 0,
                    "item_id": "application-6",
                    "parent_bullet_item_id": "application-3"
                },
                {
                    "text": "major events",
                    "type": "bullet",
                    "order": 7,
                    "indent": 0,
                    "item_id": "application-7",
                    "parent_bullet_item_id": "application-3"
                },
                {
                    "text": "exercises",
                    "type": "bullet",
                    "order": 8,
                    "indent": 0,
                    "item_id": "application-8",
                    "parent_bullet_item_id": "application-3"
                },
                {
                    "text": "air shows.",
                    "type": "bullet",
                    "order": 9,
                    "indent": 0,
                    "item_id": "application-9",
                    "parent_bullet_item_id": "application-3"
                },
                {
                    "text": "This unit applies to Defence public affairs personnel but it could apply to any personnel who work in this field.",
                    "type": "paragraph",
                    "order": 10,
                    "indent": null,
                    "item_id": "application-10",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "The skills and knowledge described in this unit must be applied within the legislative, regulatory and policy environment in which they are carried out. Organisational policies and procedures must be consulted and adhered to.",
                    "type": "paragraph",
                    "order": 11,
                    "indent": null,
                    "item_id": "application-11",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Persons undertaking this unit work independently or as part of a team and perform specific tasks in familiar contexts.",
                    "type": "paragraph",
                    "order": 12,
                    "indent": null,
                    "item_id": "application-12",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "No licensing, legislative or certification requirements apply to this unit at the time of publication.",
                    "type": "paragraph",
                    "order": 13,
                    "indent": null,
                    "item_id": "application-13",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 6,
            "table": null,
            "title": "Application"
        },
