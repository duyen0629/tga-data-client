                    "indent": 0,
                    "item_id": "performance_evidence-2",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "applying relevant legislation, regulations and operational policies to public affairs projects",
                    "type": "bullet",
                    "order": 3,
                    "indent": 0,
                    "item_id": "performance_evidence-3",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
