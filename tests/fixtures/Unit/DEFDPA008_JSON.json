        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 10,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Clarify project aim, purpose, product and outcome"
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Develop project budget and confirm with relevant project stakeholders"
                            },
                            {
                                "id": "criteria-1_3",
                                "text": "1.3 Determine and confirm project resources strategy including finance, personnel, technology and equipment requirements"
                            },
                            {
                                "id": "criteria-1_4",
                                "text": "1.4 Determine project personnel responsibilities"
                            },
                            {
                                "id": "criteria-1_5",
                                "text": "1.5 Communicate responsibilities clearly to project stakeholders and personnel"
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Define project scope"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Develop project plan including timeline, schedules, deliverables and contribution from project stakeholders"
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Develop project risk management strategy and resource management strategy in accordance with operational procedures"
                            },
                            {
                                "id": "criteria-2_3",
                                "text": "2.3 Clarify and confirm resource requirements and availability"
                            },
                            {
                                "id": "criteria-2_4",
                                "text": "2.4 Specify and confirm timeline and milestones"
                            },
                            {
                                "id": "criteria-2_5",
                                "text": "2.5 Brief relevant personnel on project plan, deadlines and responsibilities"
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Develop project plan"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Implement project plan"
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Support project personnel to ensure that project outcomes can be achieved"
                            },
                            {
                                "id": "criteria-3_3",
                                "text": "3.3 Use interpersonal skills to build trust and cooperation with project team"
                            },
                            {
                                "id": "criteria-3_4",
                                "text": "3.4 Assess progress against milestones and take contingency action as required to ensure project deadlines are met"
                            },
                            {
                                "id": "criteria-3_5",
                                "text": "3.5 Adjust project plan in accordance with contingency plans"
                            },
                            {
                                "id": "criteria-3_6",
                                "text": "3.6 Establish and maintain relevant documentation and correspondence register"
                            },
                            {
                                "id": "criteria-3_7",
                                "text": "3.7 Provide feedback to relevant personnel coordinating sections of the project"
                            },
                            {
                                "id": "criteria-3_8",
                                "text": "3.8 Finalise project within agreed timelines"
                            },
                            {
                                "id": "criteria-3_9",
                                "text": "3.9 Provide reports to management/stakeholders, as required"
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Monitor project"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-4_1",
                                "text": "4.1 Evaluate project outcomes against agreed aim and purpose"
                            },
                            {
                                "id": "criteria-4_2",
                                "text": "4.2 Evaluate project outcome quality"
                            },
                            {
                                "id": "criteria-4_3",
                                "text": "4.3 Review project plan using agreed measures"
                            },
                            {
                                "id": "criteria-4_4",
                                "text": "4.4 Communicate project evaluation outcomes with relevant personnel and incorporate recommendations into future project planning and management"
                            }
                        ],
                        "element_id": "element-4",
                        "element_text": "4 Evaluate project outcomes"
                    }
                ],
                "order": null,
                "columns": [
                    "Element",
                    "Performance Criteria"
                ]
            },
            "title": "Elements and Performance Criteria"
        },
