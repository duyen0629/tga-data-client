                    "indent": 0,
                    "item_id": "knowledge_evidence-2",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "privacy principles",
                    "type": "bullet",
                    "order": 3,
                    "indent": 0,
                    "item_id": "knowledge_evidence-3",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "project planning and coordination",
                    "type": "bullet",
