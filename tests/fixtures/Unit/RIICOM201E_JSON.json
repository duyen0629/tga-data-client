                            ],
                            [
                                {
                                    "text": "1",
                                    "type": "paragraph",
                                    "order": 1,
                                    "indent": null,
                                    "item_id": "assessment_conditions_cell-1_2_1",
                                    "parent_bullet_item_id": null
