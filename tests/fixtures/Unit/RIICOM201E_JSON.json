                },
                {
                    "text": "work health and safety procedures",
                    "type": "bullet",
                    "order": 3,
                    "indent": 1,
                    "item_id": "knowledge_evidence-3",
                    "parent_bullet_item_id": "knowledge_evidence-2"
                },
                {
                    "text": "emergency communication procedures.",
                    "type": "bullet",
                    "order": 4,
                    "indent": 1,
                    "item_id": "knowledge_evidence-4",
                    "parent_bullet_item_id": "knowledge_evidence-2"
                },
                {
