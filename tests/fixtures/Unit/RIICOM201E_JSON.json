        {
            "key": "application",
            "items": [
                {
                    "text": "This unit describes the skills and knowledge required to communicate in the workplace in the resources and infrastructure industries and other industries with relevant work practices and procedures.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "application-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "It applies to those working in operational roles. They generally work under supervision to undertake a prescribed range of functions involving known routines and procedures and take some responsibility for the quality of own work outcomes.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "application-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "No licensing, legislative or certification requirements apply to this unit at the time of publication.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "application-3",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 2,
            "table": null,
            "title": "Application"
        },
        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 3,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Obtain, interpret and confirm work requirements"
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Access, interpret and apply documentation and procedures"
                            },
                            {
                                "id": "criteria-1_3",
                                "text": "1.3 Identify and access communication equipment and system components"
                            },
                            {
                                "id": "criteria-1_4",
                                "text": "1.4 Establish and maintain communication with others"
                            },
                            {
                                "id": "criteria-1_5",
                                "text": "1.5 Access and apply communication equipment and systems safety procedures"
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Plan and prepare for workplace communication using equipment and systems"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Identify and select the most appropriate method of communication"
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Use communication equipment and systems"
                            },
                            {
                                "id": "criteria-2_3",
                                "text": "2.3 Acknowledge and respond to communication"
                            },
                            {
                                "id": "criteria-2_4",
                                "text": "2.4 Pass on communications to others in a clear and concise manner"
                            },
                            {
                                "id": "criteria-2_5",
                                "text": "2.5 Follow safety procedures, including the passing of reports and observance of local communications and emergency procedures"
                            },
                            {
                                "id": "criteria-2_6",
                                "text": "2.6 Identify and report faults in communication equipment"
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Communicate using communication equipment and systems"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Speak clearly and listen carefully to promote understanding"
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Ask questions of the audience and confirm meaning of information"
                            },
                            {
                                "id": "criteria-3_3",
                                "text": "3.3 Maintain communication processes with others to assist flow of work activities"
                            },
                            {
                                "id": "criteria-3_4",
                                "text": "3.4 Use site approved signalling methods to convey information"
                            },
                            {
                                "id": "criteria-3_5",
                                "text": "3.5 Participate in discussion to obtain information and clarify meaning"
                            },
                            {
                                "id": "criteria-3_6",
                                "text": "3.6 Communicate cooperatively and effectively with others"
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Carry out face-to-face routine communication"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-4_1",
                                "text": "4.1 Complete written documentation clearly, concisely and on time"
                            },
                            {
                                "id": "criteria-4_2",
                                "text": "4.2 Use approved documents according to workplace procedures"
                            },
                            {
                                "id": "criteria-4_3",
                                "text": "4.3 Pass on written information to others"
                            }
                        ],
                        "element_id": "element-4",
                        "element_text": "4 Complete written documentation"
                    }
                ],
                "order": null,
                "columns": [
                    "Element",
                    "Performance Criteria"
                ]
            },
            "title": "Elements and Performance Criteria"
        },
        {
