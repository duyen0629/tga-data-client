        {
            "key": "performance_evidence",
            "items": [
                {
                    "text": "The candidate must demonstrate the ability to complete the tasks outlined in the elements, performance criteria and foundation skills of this unit, including evidence of the ability to:",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "performance_evidence-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "communicate in the workplace on at least two occasions, including:",
                    "type": "bullet",
                    "order": 2,
                    "indent": 0,
                    "item_id": "performance_evidence-2",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "identifying communication strategies and systems",
                    "type": "bullet",
                    "order": 3,
                    "indent": 1,
                    "item_id": "performance_evidence-3",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "operating communications systems and equipment to convey meaning to others",
                    "type": "bullet",
                    "order": 4,
                    "indent": 1,
                    "item_id": "performance_evidence-4",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "communicating clearly and promptly to others to convey information and meaning",
                    "type": "bullet",
                    "order": 5,
                    "indent": 1,
                    "item_id": "performance_evidence-5",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "listening carefully to instructions and information",
                    "type": "bullet",
                    "order": 6,
                    "indent": 1,
                    "item_id": "performance_evidence-6",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "participating in group discussions and engage with group members respectfully",
                    "type": "bullet",
                    "order": 7,
                    "indent": 1,
                    "item_id": "performance_evidence-7",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "asking questions to clarify meaning",
                    "type": "bullet",
                    "order": 8,
                    "indent": 1,
                    "item_id": "performance_evidence-8",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "communicating concisely both written and verbally",
                    "type": "bullet",
                    "order": 9,
                    "indent": 1,
                    "item_id": "performance_evidence-9",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "interpreting communications devices",
                    "type": "bullet",
                    "order": 10,
                    "indent": 1,
                    "item_id": "performance_evidence-10",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "identifying and reporting communication faults and deficiencies.",
                    "type": "bullet",
                    "order": 11,
                    "indent": 1,
                    "item_id": "performance_evidence-11",
                    "parent_bullet_item_id": "performance_evidence-2"
                }
            ],
            "order": 7,
            "table": null,
            "title": "Performance Evidence"
        },
        {
            "key": "knowledge_evidence",
            "items": [
                {
