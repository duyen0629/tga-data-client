        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 6,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Legislation, regulations, standards, codes of practice and organisational workplace requirements for work to be performed are referred to and confirmed"
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Work plan is obtained and confirmed in accordance with workplace requirements"
                            },
                            {
                                "id": "criteria-1_3",
                                "text": "1.3 Materials required for work are determined and obtained in accordance with work plan and workplace requirements"
                            },
                            {
                                "id": "criteria-1_4",
                                "text": "1.4 Tools, equipment and personal protective equipment (PPE) required for work are determined, obtained and confirmed in working order"
                            },
                            {
                                "id": "criteria-1_5",
                                "text": "1.5 Hazards are identified, risks assessed and control measures identified and applied"
                            },
                            {
                                "id": "criteria-1_6",
                                "text": "1.6 Work is prioritised and sequenced for completion in accordance with work plan and workplace requirements"
                            },
                            {
                                "id": "criteria-1_7",
                                "text": "1.7 Worksite is prepared in accordance with the work plan and workplace requirements"
                            },
                            {
                                "id": "criteria-1_8",
                                "text": "1.8 Liaison and communication with stakeholders is carried out in accordance with workplace requirements"
                            },
                            {
                                "id": "criteria-1_9",
                                "text": "1.9 Traffic management plan is confirmed as being in place in accordance with workplace requirements"
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Prepare to treat poles"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Legislation, regulations, standards, codes of practice and organisational workplace requirements for the work to be performed are applied and monitored"
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Lifting and the use of tools, equipment and PPE are carried out in accordance with workplace requirements"
                            },
                            {
                                "id": "criteria-2_3",
                                "text": "2.3 Hazard control measures are monitored in accordance with workplace requirements"
                            },
                            {
                                "id": "criteria-2_4",
                                "text": "2.4 Treatment of poles is performed in accordance with work plan and workplace requirements"
                            },
                            {
                                "id": "criteria-2_5",
                                "text": "2.5 Incidents or unplanned events are responded to in accordance with workplace requirements"
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Apply treatment to poles"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Completed work is checked for compliance against the work plan and workplace requirements"
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Incidents or unplanned events are reported in accordance with workplace requirements"
                            },
                            {
                                "id": "criteria-3_3",
                                "text": "3.3 Worksite is rehabilitated, cleaned and made safe in accordance with workplace requirements"
                            },
                            {
                                "id": "criteria-3_4",
                                "text": "3.4 Tools and equipment are cleaned, checked and returned to storage in accordance with workplace requirements"
                            },
                            {
                                "id": "criteria-3_5",
                                "text": "3.5 Surplus materials are returned to storage or disposed of in accordance with workplace requirements"
                            },
                            {
                                "id": "criteria-3_6",
                                "text": "3.6 Work records, reports and documentation are completed, and appropriate personnel notified in accordance with workplace requirements"
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Complete work and documentation"
                    }
                ],
                "order": null,
                "columns": [
                    "Element",
                    "Performance Criteria"
                ]
            },
            "title": "Elements and Performance Criteria"
        },
