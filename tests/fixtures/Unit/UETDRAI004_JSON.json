        {
            "key": "performance_evidence",
            "items": [
                {
                    "text": "Evidence required to demonstrate competence in this unit must be relevant to and satisfy all of the requirements of the elements and performance criteria on at least two separate occasions and include:",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "performance_evidence-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "applying relevant legislation, regulations, standards, codes of practice and organisational workplace requirements, including:",
                    "type": "bullet",
                    "order": 2,
                    "indent": 0,
                    "item_id": "performance_evidence-2",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "work health and safety (WHS)/occupational health and safety (OHS)",
                    "type": "bullet",
                    "order": 3,
                    "indent": 1,
                    "item_id": "performance_evidence-3",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "environmental requirements",
                    "type": "bullet",
                    "order": 4,
                    "indent": 1,
                    "item_id": "performance_evidence-4",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "identifying hazards, assessing risks, identifying, applying and monitoring control measures",
                    "type": "bullet",
                    "order": 5,
                    "indent": 0,
                    "item_id": "performance_evidence-5",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "obtaining, inspecting and using relevant personal protective equipment (PPE)",
                    "type": "bullet",
                    "order": 6,
                    "indent": 0,
                    "item_id": "performance_evidence-6",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "applying treatment applications to at least two (2) of the following pole types:",
                    "type": "bullet",
                    "order": 7,
                    "indent": 0,
                    "item_id": "performance_evidence-7",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "wood",
                    "type": "bullet",
                    "order": 8,
                    "indent": 1,
                    "item_id": "performance_evidence-8",
                    "parent_bullet_item_id": "performance_evidence-7"
                },
                {
                    "text": "steel",
                    "type": "bullet",
                    "order": 9,
                    "indent": 1,
                    "item_id": "performance_evidence-9",
                    "parent_bullet_item_id": "performance_evidence-7"
                },
                {
                    "text": "concrete",
                    "type": "bullet",
                    "order": 10,
                    "indent": 1,
                    "item_id": "performance_evidence-10",
                    "parent_bullet_item_id": "performance_evidence-7"
                },
                {
                    "text": "composite",
                    "type": "bullet",
                    "order": 11,
                    "indent": 1,
                    "item_id": "performance_evidence-11",
                    "parent_bullet_item_id": "performance_evidence-7"
                },
                {
                    "text": "handling, transporting, storing and disposing of treatment applications",
                    "type": "bullet",
                    "order": 12,
                    "indent": 0,
                    "item_id": "performance_evidence-12",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "dealing with an unplanned event on at least one (1) occasion",
                    "type": "bullet",
                    "order": 13,
                    "indent": 0,
                    "item_id": "performance_evidence-13",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "completing relevant work records, reports and documentation.",
                    "type": "bullet",
                    "order": 14,
                    "indent": 0,
                    "item_id": "performance_evidence-14",
                    "parent_bullet_item_id": "performance_evidence-1"
                }
            ],
            "order": 11,
            "table": null,
            "title": "Performance Evidence"
        },
        {
            "key": "knowledge_evidence",
            "items": [
                {
                    "text": "Evidence required to demonstrate competence in this unit must be relevant to and satisfy all of the requirements of the elements and performance criteria and include knowledge of:",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "knowledge_evidence-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "relevant legislation, regulations, standards, codes of practice, and organisational workplace requirements, including:",
                    "type": "bullet",
                    "order": 2,
                    "indent": 0,
                    "item_id": "knowledge_evidence-2",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "WHS/OHS",
                    "type": "bullet",
                    "order": 3,
                    "indent": 1,
                    "item_id": "knowledge_evidence-3",
                    "parent_bullet_item_id": "knowledge_evidence-2"
                },
                {
                    "text": "environmental",
                    "type": "bullet",
                    "order": 4,
                    "indent": 1,
                    "item_id": "knowledge_evidence-4",
                    "parent_bullet_item_id": "knowledge_evidence-2"
                },
                {
                    "text": "hazard, risk assessment and risk control requirements, including potential hazards",
                    "type": "bullet",
                    "order": 5,
                    "indent": 0,
                    "item_id": "knowledge_evidence-5",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "types and application of PPE",
                    "type": "bullet",
                    "order": 6,
                    "indent": 0,
                    "item_id": "knowledge_evidence-6",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "safe use of tools and equipment",
                    "type": "bullet",
                    "order": 7,
                    "indent": 0,
                    "item_id": "knowledge_evidence-7",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "events constituting an unplanned event or incident",
                    "type": "bullet",
                    "order": 8,
                    "indent": 0,
                    "item_id": "knowledge_evidence-8",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "procedures for responding to an unplanned event or incident",
                    "type": "bullet",
                    "order": 9,
                    "indent": 0,
                    "item_id": "knowledge_evidence-9",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "procedures for work records, reports and documentation",
                    "type": "bullet",
                    "order": 10,
                    "indent": 0,
                    "item_id": "knowledge_evidence-10",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "treatment applications, including:",
                    "type": "bullet",
                    "order": 11,
                    "indent": 0,
                    "item_id": "knowledge_evidence-11",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "types and characteristics",
                    "type": "bullet",
                    "order": 12,
                    "indent": 1,
                    "item_id": "knowledge_evidence-12",
                    "parent_bullet_item_id": "knowledge_evidence-11"
                },
                {
                    "text": "safe handling and application",
                    "type": "bullet",
                    "order": 13,
                    "indent": 1,
                    "item_id": "knowledge_evidence-13",
                    "parent_bullet_item_id": "knowledge_evidence-11"
                },
                {
                    "text": "storage",
                    "type": "bullet",
                    "order": 14,
                    "indent": 1,
                    "item_id": "knowledge_evidence-14",
                    "parent_bullet_item_id": "knowledge_evidence-11"
                },
                {
                    "text": "transport",
                    "type": "bullet",
                    "order": 15,
                    "indent": 1,
                    "item_id": "knowledge_evidence-15",
                    "parent_bullet_item_id": "knowledge_evidence-11"
                },
                {
                    "text": "disposal.",
                    "type": "bullet",
                    "order": 16,
                    "indent": 1,
                    "item_id": "knowledge_evidence-16",
                    "parent_bullet_item_id": "knowledge_evidence-11"
                }
            ],
            "order": 12,
            "table": null,
            "title": "Knowledge Evidence"
        },
        {
            "key": "assessment_conditions",
            "items": [
                {
                    "text": "Assessors must hold credentials specified within the Standards for Registered Training Organisations current at the time of assessment.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "assessment_conditions-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Assessment must satisfy the Principles of Assessment and Rules of Evidence and all regulatory requirements included within the Standards for Registered Training Organisations current at the time of assessment.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "assessment_conditions-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Assessment must occur in workplace operational situations, where it is appropriate to do so.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "assessment_conditions-3",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Where this is not appropriate, assessment must occur in simulated conditions involving realistic and authentic activities that replicate operational workplace conditions.",
                    "type": "paragraph",
                    "order": 4,
                    "indent": null,
                    "item_id": "assessment_conditions-4",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Assessment processes and techniques must be appropriate to the language, literacy and numeracy requirements of the work being performed and the needs of the candidate.",
                    "type": "paragraph",
                    "order": 5,
                    "indent": null,
                    "item_id": "assessment_conditions-5",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Resources for assessment must include access to:",
                    "type": "paragraph",
                    "order": 6,
                    "indent": null,
                    "item_id": "assessment_conditions-6",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "relevant and appropriate materials, tools, equipment and PPE currently used to treat poles",
                    "type": "bullet",
                    "order": 7,
                    "indent": 0,
                    "item_id": "assessment_conditions-7",
                    "parent_bullet_item_id": "assessment_conditions-6"
                },
                {
                    "text": "applicable documentation, including workplace requirements, equipment specifications, regulations, codes of practice and operation manuals.",
                    "type": "bullet",
                    "order": 8,
                    "indent": 0,
                    "item_id": "assessment_conditions-8",
                    "parent_bullet_item_id": "assessment_conditions-6"
                }
            ],
            "order": 13,
            "table": null,
            "title": "Assessment Conditions"
        }
    ]
}