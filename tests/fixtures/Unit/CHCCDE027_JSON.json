        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 6,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Communicate with individuals and groups to ensure that their story is heard and understood, and to test that there is common understanding."
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Respond to individual and group issues in a manner which shows respect for and a commitment to assist in their resolution."
                            },
                            {
                                "id": "criteria-1_3",
                                "text": "1.3 Proactively provide referrals to assist in the resolution of issues."
                            },
                            {
                                "id": "criteria-1_4",
                                "text": "1.4 Identify and address barriers to moving private concerns into public action."
                            },
                            {
                                "id": "criteria-1_5",
                                "text": "1.5 Identify individual and community strengths, talents and abilities that can address community priorities."
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Work with individuals and groups to identify issues."
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Identify relevant models of work and establish mechanisms and actions to address group priorities and strengths."
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Organise opportunities to facilitate community participation."
                            },
                            {
                                "id": "criteria-2_3",
                                "text": "2.3 Establish common goals and coordinate strategies for a cooperative group process."
                            },
                            {
                                "id": "criteria-2_4",
                                "text": "2.4 Engage key stakeholders in planning, implementing and evaluating strategies for community empowerment and action."
                            },
                            {
                                "id": "criteria-2_5",
                                "text": "2.5 Follow organisational policies and procedures for reporting."
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Work with groups to establish cooperative processes."
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Identify strengths and assets and access available resources to facilitate group and community work strategies and activities."
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Participate in facilitation of effective group meetings to enhance outcomes."
                            },
                            {
                                "id": "criteria-3_3",
                                "text": "3.3 Support and maintain group processes to facilitate achievement of identified outcomes by the group."
                            },
                            {
                                "id": "criteria-3_4",
                                "text": "3.4 Monitor effectiveness of group processes and provide information to the group to enable improvement and change."
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Support group processes and skills development."
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-4_1",
                                "text": "4.1 Reflect on and improve own practice."
                            },
                            {
                                "id": "criteria-4_2",
                                "text": "4.2 Regularly participate in a review mechanism as a commitment to upgrading skills and knowledge."
                            },
                            {
                                "id": "criteria-4_3",
                                "text": "4.3 Work with the group to reflect on group practice and processes and identify areas for improvement."
                            }
                        ],
                        "element_id": "element-4",
                        "element_text": "4 Reflect on practice."
                    }
                ],
                "order": null,
                "columns": [
                    "Element",
                    "Performance Criteria"
                ]
            },
            "title": "Elements and Performance Criteria"
        },
