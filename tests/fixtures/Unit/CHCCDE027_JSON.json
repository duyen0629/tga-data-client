        {
            "key": "application",
            "items": [
                {
                    "text": "This unit describes the performance outcomes, skills and knowledge required to work with individuals, groups and the community to identify issues and develop cooperative processes to facilitate change.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "application-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "This unit applies to workers using a community development approach to carry out work in the health, community services or other sectors. Workers at this level are part of a professional team and have the responsibility of supervision of others.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "application-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "The skills in this unit must be applied in accordance with Commonwealth and State or Territory legislation, Australian standards and industry codes of practice.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "application-3",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "No occupational licensing, certification or specific legislative requirements apply to this unit at the time of publication.",
                    "type": "paragraph",
                    "order": 4,
                    "indent": null,
                    "item_id": "application-4",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 2,
            "table": null,
            "title": "Application"
        },
