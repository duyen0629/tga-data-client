        {
            "key": "application",
            "items": [
                {
                    "text": "This unit describes the skills and knowledge required to prepare, facilitate and lead difficult conversations.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "application-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "The unit applies to individuals who may work as managers and leaders, and are required to lead difficult conversations in the workplace. They contribute well developed verbal and relationship building skills in having difficult conversations.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "application-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "No licensing, legislative or certification requirements apply to this unit at the time of publication.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "application-3",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 6,
            "table": null,
            "title": "Application"
        },
