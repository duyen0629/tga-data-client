        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 8,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Identify conversational requirements"
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Identify, gather and develop materials required for the conversation according to organisational policies and procedures"
                            },
                            {
                                "id": "criteria-1_3",
                                "text": "1.3 Organise the logistics and stakeholders required for the conversation"
                            },
                            {
                                "id": "criteria-1_4",
                                "text": "1.4 Seek feedback from relevant personnel on conversational content"
                            },
                            {
                                "id": "criteria-1_5",
                                "text": "1.5 Review conversational content and make changes according to feedback received"
                            },
                            {
                                "id": "criteria-1_6",
                                "text": "1.6 Select delivery style according to conversational context and stakeholder requirements"
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Prepare for conversation"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Undertake conversation with relevant stakeholders"
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Provide opportunity for stakeholder input"
                            },
                            {
                                "id": "criteria-2_3",
                                "text": "2.3 Confirm relevant stakeholders understand conversation and outcomes"
                            },
                            {
                                "id": "criteria-2_4",
                                "text": "2.4 Document relevant points of conversation"
                            },
                            {
                                "id": "criteria-2_5",
                                "text": "2.5 Refer stakeholders to relevant support services, as required"
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Facilitate difficult conversation"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Evaluate own effectiveness in the conversation"
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Seek and respond to feedback from relevant personnel on personal performance"
                            },
                            {
                                "id": "criteria-3_3",
                                "text": "3.3 Identify areas of improvement for undertaking difficult conversations according to feedback received"
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Follow up and review conversation"
                    }
                ],
                "order": null,
                "columns": [
                    "Element",
                    "Performance Criteria"
                ]
            },
            "title": "Elements and Performance Criteria"
        },
        {
