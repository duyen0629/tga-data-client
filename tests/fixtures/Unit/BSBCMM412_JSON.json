        {
            "key": "performance_evidence",
            "items": [
                {
                    "text": "The candidate must demonstrate the ability to complete the tasks outlined in the elements, performance criteria and foundation skills of this unit, including evidence of the ability to:",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "performance_evidence-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "lead at least two difficult conversations in the workplace.",
                    "type": "bullet",
                    "order": 2,
                    "indent": 0,
                    "item_id": "performance_evidence-2",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "In the course of the above, the candidate must:",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "performance_evidence-3",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "adapt delivery style and tone according to the mood of the conversation",
                    "type": "bullet",
                    "order": 4,
                    "indent": 0,
                    "item_id": "performance_evidence-4",
                    "parent_bullet_item_id": "performance_evidence-3"
                },
                {
                    "text": "understand and react to relevant personnel using conviction and empathy.",
                    "type": "bullet",
                    "order": 5,
                    "indent": 0,
                    "item_id": "performance_evidence-5",
                    "parent_bullet_item_id": "performance_evidence-3"
                }
            ],
            "order": 2,
            "table": null,
            "title": "Performance Evidence"
        },
        {
            "key": "knowledge_evidence",
            "items": [
                {
                    "text": "The candidate must be able to demonstrate knowledge to complete the tasks outlined in the elements, performance criteria and foundation skills of this unit, including knowledge of:",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "knowledge_evidence-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "legislation, standards and codes of practice relating to workplace communication",
                    "type": "bullet",
                    "order": 2,
                    "indent": 0,
                    "item_id": "knowledge_evidence-2",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "workplace policies and procedures relevant to communication",
                    "type": "bullet",
                    "order": 3,
                    "indent": 0,
                    "item_id": "knowledge_evidence-3",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "communication styles",
                    "type": "bullet",
                    "order": 4,
                    "indent": 0,
                    "item_id": "knowledge_evidence-4",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "delivery styles, tones and techniques of communication, including:",
                    "type": "bullet",
                    "order": 5,
                    "indent": 0,
                    "item_id": "knowledge_evidence-5",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "verbal and non-verbal communication",
                    "type": "bullet",
                    "order": 6,
                    "indent": 1,
                    "item_id": "knowledge_evidence-6",
                    "parent_bullet_item_id": "knowledge_evidence-5"
                },
                {
                    "text": "conviction and empathy",
                    "type": "bullet",
                    "order": 7,
                    "indent": 1,
                    "item_id": "knowledge_evidence-7",
                    "parent_bullet_item_id": "knowledge_evidence-5"
                },
                {
                    "text": "common support services.",
                    "type": "bullet",
                    "order": 8,
                    "indent": 0,
                    "item_id": "knowledge_evidence-8",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                }
            ],
            "order": 3,
            "table": null,
            "title": "Knowledge Evidence"
