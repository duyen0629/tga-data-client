        {
            "key": "assessment_conditions",
            "items": [
                {
                    "text": "Skills in this unit must be demonstrated in a workplace or simulated environment where the conditions are typical of those in a working environment in this industry. This includes access to:",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "assessment_conditions-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "workplace documentation and resources relevant to performance evidence.",
                    "type": "bullet",
                    "order": 2,
                    "indent": 0,
                    "item_id": "assessment_conditions-2",
                    "parent_bullet_item_id": "assessment_conditions-1"
                },
                {
                    "text": "Assessors of this unit must satisfy the requirements for assessors in applicable vocational education and training legislation, frameworks and/or standards.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "assessment_conditions-3",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 4,
            "table": null,
            "title": "Assessment Conditions"
        },
