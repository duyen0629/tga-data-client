            "key": "assessment_conditions",
            "items": [
                {
                    "text": "Assessors must satisfy the requirements for assessors listed in the Standards for Registered Training Organisations.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "assessment_conditions-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Assessment can be undertaken in the workplace or in a simulated workplace environment.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "assessment_conditions-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "A simulated environment is one that realistically replicates workplace conditions, materials and equipment, interactions with others and workplace irregularities, and which meets industry standards for safety and environmental practices.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "assessment_conditions-3",
                    "parent_bullet_item_id": null
                },
                {
