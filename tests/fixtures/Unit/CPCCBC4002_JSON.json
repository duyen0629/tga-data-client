        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 9,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Evaluate construction site safety and identify potential risk areas."
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Assess on site worker’s health and safety."
                            },
                            {
                                "id": "criteria-1_3",
                                "text": "1.3 Identify hazards and determine control measures that comply with legislative requirements and organisational policies."
                            },
                            {
                                "id": "criteria-1_4",
                                "text": "1.4 Consult with workers to evaluate effectiveness of existing control measures and WHS experts, as necessary, to contribute to an inspection report."
                            },
                            {
                                "id": "criteria-1_5",
                                "text": "1.5 Complete a workplace inspection report with recommended actions to minimise workplace incidents and mitigate risk."
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Assess workplace risk."
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Establish a workplace safety plan incorporating information from the workplace inspection report to raise safety awareness and support safe workplace practices."
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Implement processes to identify hazards, rate the risks and put control measures in place."
                            },
                            {
                                "id": "criteria-2_3",
                                "text": "2.3 Establish educational programs specific to the building and construction workplace to ensure workers carry out safe work practices."
                            },
                            {
                                "id": "criteria-2_4",
                                "text": "2.4 Negotiate and resolve safety issues and conflicts."
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Establish and implement safety plans."
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Monitor and audit workplace safety to ensure compliance with WHS regulations and workplace safety requirements."
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Record findings and recommend and implement actions to address non-compliance."
                            },
                            {
                                "id": "criteria-3_3",
                                "text": "3.3 Review effectiveness of educational programs to ensure all workers have been inducted and maintain safe work practices."
                            },
                            {
                                "id": "criteria-3_4",
                                "text": "3.4 Monitor, review and document effectiveness of control measures to determine changes and improvements as required."
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Monitor workplace safety."
                    }
                ],
                "order": null,
                "columns": [
                    "Element",
                    "Performance Criteria"
                ]
            },
            "title": "Elements and Performance Criteria"
