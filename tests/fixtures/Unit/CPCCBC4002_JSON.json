        {
            "key": "performance_evidence",
            "items": [
                {
                    "text": "To demonstrate competency, a candidate must meet the performance criteria of this unit by conducting a workplace safety audit for a construction worksite.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "performance_evidence-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "In doing this, a candidate must:",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "performance_evidence-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "access and interpret relevant government work health and safety (WHS) legislation and regulations",
                    "type": "bullet",
                    "order": 3,
                    "indent": 0,
                    "item_id": "performance_evidence-3",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "identify faults, problems and non-compliances and their impact on workplace safety",
                    "type": "bullet",
                    "order": 4,
                    "indent": 0,
                    "item_id": "performance_evidence-4",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "introduce safety systems allowing for ease of reporting safety issues, controlling hazards and maintaining worker safety and competence.",
                    "type": "bullet",
                    "order": 5,
                    "indent": 0,
                    "item_id": "performance_evidence-5",
                    "parent_bullet_item_id": "performance_evidence-2"
                }
            ],
            "order": 2,
            "table": null,
            "title": "Performance Evidence"
        },
