        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 4,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Identify organisational vision, mission and values"
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Identify, gather and analyse relevant organisational data according to organisational policies and procedures"
                            },
                            {
                                "id": "criteria-1_3",
                                "text": "1.3 Identify stakeholders and resources required to develop and review strategic plan"
                            },
                            {
                                "id": "criteria-1_4",
                                "text": "1.4 Conduct strengths, weaknesses, opportunities and threats (SWOT) analysis and determine and define strengths, weaknesses, opportunities and threats"
                            },
                            {
                                "id": "criteria-1_5",
                                "text": "1.5 Review current strategic plan and identify gaps, and improvement needs and opportunities"
                            },
                            {
                                "id": "criteria-1_6",
                                "text": "1.6 Conduct political, economic, social and technological (PEST) analysis and identify opportunities and threats due to political, economic, social and technological forces"
                            },
                            {
                                "id": "criteria-1_7",
                                "text": "1.7 Research global environment and market, and identify trends, best practice, risks and opportunities"
                            },
                            {
                                "id": "criteria-1_8",
                                "text": "1.8 Assess organisational and global markets’ current and future demands"
                            },
                            {
                                "id": "criteria-1_9",
                                "text": "1.9 Identify barriers to organisational goals and consult with relevant stakeholders to determine strategies to overcome barriers"
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Analyse environment"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Establish communication processes that inform and support relevant team members"
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Consult with relevant stakeholders to determine parameters for planning process"
                            },
                            {
                                "id": "criteria-2_3",
                                "text": "2.3 Assign actions to relevant staff for developing planning process and direction of strategic plan"
                            },
                            {
                                "id": "criteria-2_4",
                                "text": "2.4 Develop planning process and direction of strategic plan"
                            },
                            {
                                "id": "criteria-2_5",
                                "text": "2.5 Establish organisational goals and priorities"
                            },
                            {
                                "id": "criteria-2_6",
                                "text": "2.6 Determine financial forecast and budgets"
                            },
                            {
                                "id": "criteria-2_7",
                                "text": "2.7 Seek feedback from stakeholders on direction of strategic plan and established organisational goals and priorities"
                            },
                            {
                                "id": "criteria-2_8",
                                "text": "2.8 Develop strategy map and identify gaps for improvement in direction of strategic plan"
                            },
                            {
                                "id": "criteria-2_9",
                                "text": "2.9 Make changes according to feedback received and identified improvements"
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Determine direction of strategic plan"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Determine and set key performance indicators, budget and timeline"
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Develop annual operational plan to facilitate implementation of long-term strategic plan"
                            },
                            {
                                "id": "criteria-3_3",
                                "text": "3.3 Plan human resource development and succession strategies that confirm long-term business viability"
                            },
                            {
                                "id": "criteria-3_4",
                                "text": "3.4 Initiate strategies to skill own workforce to implement the strategic plan"
                            },
                            {
                                "id": "criteria-3_5",
                                "text": "3.5 Present recommendations to key stakeholders for feedback and make changes to strategic plan according to feedback received"
                            },
                            {
                                "id": "criteria-3_6",
                                "text": "3.6 Communicate with stakeholders and assign responsibilities"
                            },
                            {
                                "id": "criteria-3_7",
                                "text": "3.7 Assist stakeholders to implement strategies"
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Develop and execute strategic plan"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-4_1",
                                "text": "4.1 Develop knowledge management systems to capture team progress, insights, experiences and learnings"
                            },
                            {
                                "id": "criteria-4_2",
                                "text": "4.2 Monitor financial and non-financial performance indicators"
                            },
                            {
                                "id": "criteria-4_3",
                                "text": "4.3 Monitor progress against timeline and key performance indicators"
                            },
                            {
                                "id": "criteria-4_4",
                                "text": "4.4 Identify progress that has not been made according to timeline and key performance indicators and communicate with relevant stakeholders to identify required actions"
                            },
                            {
                                "id": "criteria-4_5",
                                "text": "4.5 Seek feedback from relevant stakeholders on strategies and document feedback received for future development of strategic plans"
                            }
                        ],
                        "element_id": "element-4",
                        "element_text": "4 Monitor and review strategic plan"
                    }
                ],
                "order": null,
                "columns": [
                    "Element",
                    "Performance Criteria"
                ]
            },
            "title": "Elements and Performance Criteria"
        },
