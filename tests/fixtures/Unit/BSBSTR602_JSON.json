        {
            "key": "application",
            "items": [
                {
                    "text": "This unit describes the skills and knowledge required to establish the strategic direction of the organisation, sustain competitive advantage and enhance competitiveness. It covers analysis and interpretation of relevant markets, capability assessment of the organisation and analysis of the organisation’s existing and potential competitors and allies. It also covers implementing the strategic plan and developing specific actions and initiatives that will be undertaken by people working in various roles.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "application-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "The unit applies to individuals working in senior roles in the organisation who have responsibility for ensuring that the organisation is positioned to ensure its long-term viability and success.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "application-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "No licensing, legislative or certification requirements apply to this unit at the time of publication.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "application-3",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 2,
            "table": null,
            "title": "Application"
        },
