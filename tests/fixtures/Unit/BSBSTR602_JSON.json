                    "type": "bullet",
                    "order": 4,
                    "indent": 1,
                    "item_id": "performance_evidence-4",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "obtaining input to and endorsement of strategic plans",
                    "type": "bullet",
                    "order": 5,
                    "indent": 1,
                    "item_id": "performance_evidence-5",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
