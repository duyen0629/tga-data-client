        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 4,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Identify organisation’s strategic direction, vision and mission"
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Consult with relevant stakeholders on required changes to vision and mission"
                            },
                            {
                                "id": "criteria-1_3",
                                "text": "1.3 Review and develop or revise organisational values to support the vision and mission statement"
                            },
                            {
                                "id": "criteria-1_4",
                                "text": "1.4 Seek support for strategic planning process from all relevant stakeholders"
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Confirm vision and mission of the organisation"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Analyse and undertake research to understand external environment"
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Undertake political, economic, social, and technological (PEST) analysis"
                            },
                            {
                                "id": "criteria-2_3",
                                "text": "2.3 Undertake capability assessment of competitor organisations"
                            },
                            {
                                "id": "criteria-2_4",
                                "text": "2.4 Analyse organisation’s strengths, weaknesses, opportunities and threats (SWOT)"
                            },
                            {
                                "id": "criteria-2_5",
                                "text": "2.5 Establish cooperative ventures, that are supported by risk and cost benefit analyses, according to organisational vision, mission and values and provide for due diligence, where required"
                            },
                            {
                                "id": "criteria-2_6",
                                "text": "2.6 Seek and respond to feedback from relevant stakeholders on analysis internal and external environments"
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Analyse internal and external environment"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Document relevant research and background for inclusion in the strategic plan"
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Develop objectives and strategies relevant for the future"
                            },
                            {
                                "id": "criteria-3_3",
                                "text": "3.3 Detail each strategy with a priority, a timeframe, responsible stakeholders and measurable performance indicators"
                            },
                            {
                                "id": "criteria-3_4",
                                "text": "3.4 Identify risks and develop a risk management plan"
                            },
                            {
                                "id": "criteria-3_5",
                                "text": "3.5 Circulate strategic plan and risk management plan for feedback and endorsement"
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Develop strategic organisational plan"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-4_1",
                                "text": "4.1 Communicate strategic plan to all relevant stakeholders"
                            },
                            {
                                "id": "criteria-4_2",
                                "text": "4.2 Develop actions and initiatives for team members to undertake"
                            },
                            {
                                "id": "criteria-4_3",
                                "text": "4.3 Assign team members’ roles in relation to strategic objectives"
                            },
                            {
                                "id": "criteria-4_4",
                                "text": "4.4 Use performance indicators to monitor progress in implementing plan and make refinements to plan"
                            },
                            {
                                "id": "criteria-4_5",
                                "text": "4.5 Evaluate achievement of objectives at agreed milestones with relevant stakeholders"
                            },
                            {
                                "id": "criteria-4_6",
                                "text": "4.6 Review effectiveness of plan and consider methods for improving strategic planning processes"
                            }
                        ],
                        "element_id": "element-4",
                        "element_text": "4 Implement strategic organisational plan"
                    }
                ],
                "order": null,
                "columns": [
                    "Element",
                    "Performance Criteria"
                ]
            },
            "title": "Elements and Performance Criteria"
        },
        {
