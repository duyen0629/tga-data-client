        {
            "key": "performance_evidence",
            "items": [
                {
                    "text": "Evidence required to demonstrate competence must satisfy all of the requirements of the elements and performance criteria. If not otherwise specified the candidate must demonstrate evidence of performance of the following on at least one occasion:",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "performance_evidence-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "analysing and evaluating geospatial information",
                    "type": "bullet",
                    "order": 2,
                    "indent": 0,
                    "item_id": "performance_evidence-2",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "conducting research to clarify issues and unclear findings",
                    "type": "bullet",
                    "order": 3,
                    "indent": 0,
                    "item_id": "performance_evidence-3",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "identifying the issues surrounding the provision of advice",
                    "type": "bullet",
                    "order": 4,
                    "indent": 0,
                    "item_id": "performance_evidence-4",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "identifying geospatial capabilities",
                    "type": "bullet",
                    "order": 5,
                    "indent": 0,
                    "item_id": "performance_evidence-5",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "identifying and providing current and future capability options related to current and future Defence operations and training",
                    "type": "bullet",
                    "order": 6,
                    "indent": 0,
                    "item_id": "performance_evidence-6",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "liaising with stakeholders in providing advice and receiving feedback in a constructive manner",
                    "type": "bullet",
                    "order": 7,
                    "indent": 0,
                    "item_id": "performance_evidence-7",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "preparing and presenting reports",
                    "type": "bullet",
                    "order": 8,
                    "indent": 0,
                    "item_id": "performance_evidence-8",
                    "parent_bullet_item_id": "performance_evidence-1"
                }
            ],
            "order": 11,
            "table": null,
            "title": "Performance Evidence"
        },
        {
            "key": "knowledge_evidence",
            "items": [
                {
                    "text": "Evidence required to demonstrate competence, must satisfy all of the requirements of the elements and performance criteria and include knowledge of:",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "knowledge_evidence-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "capability requirements for current and future Defence operations and training",
                    "type": "bullet",
                    "order": 2,
                    "indent": 0,
                    "item_id": "knowledge_evidence-2",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "research and analysis techniques for identifying and clarifying issues",
                    "type": "bullet",
                    "order": 3,
                    "indent": 0,
                    "item_id": "knowledge_evidence-3",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "Australian Defence Force (ADF) regulatory requirements, and organisational policy, standard operational procedures including code of behaviour",
                    "type": "bullet",
                    "order": 4,
                    "indent": 0,
                    "item_id": "knowledge_evidence-4",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "geospatial technical information sources",
                    "type": "bullet",
                    "order": 5,
                    "indent": 0,
                    "item_id": "knowledge_evidence-5",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "relevant policies and procedures in relation to duty of care, ethical standards, geospatial capabilities and all other organisational requirements",
                    "type": "bullet",
                    "order": 6,
                    "indent": 0,
                    "item_id": "knowledge_evidence-6",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "verbal communication techniques for clarifying issues and providing advice to stakeholders",
                    "type": "bullet",
                    "order": 7,
                    "indent": 0,
                    "item_id": "knowledge_evidence-7",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "written communication techniques for preparing letters and reports",
                    "type": "bullet",
                    "order": 8,
                    "indent": 0,
                    "item_id": "knowledge_evidence-8",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                }
            ],
            "order": 12,
            "table": null,
            "title": "Knowledge Evidence"
        },
        {
            "key": "assessment_conditions",
            "items": [
                {
                    "text": "As a minimum, assessors must satisfy applicable regulatory requirements, which include requirements in the Standards for Registered Training Organisations current at the time of assessment.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "assessment_conditions-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "As a minimum, assessment must satisfy applicable regulatory requirements, which include requirements in the Standards for Registered Training Organisations current at the time of assessment.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "assessment_conditions-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Assessment processes and techniques must be appropriate to the language, literacy and numeracy requirements of the work being performed and the needs of the candidate.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "assessment_conditions-3",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Assessment must occur in workplace operational situations. Where this is not appropriate, assessment must occur in simulated workplace operational situations that reflect workplace conditions.",
                    "type": "paragraph",
                    "order": 4,
                    "indent": null,
                    "item_id": "assessment_conditions-4",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Resources for assessment must include access to:",
                    "type": "paragraph",
                    "order": 5,
                    "indent": null,
                    "item_id": "assessment_conditions-5",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "a range of relevant exercises, case studies and/or other simulations",
                    "type": "bullet",
                    "order": 6,
                    "indent": 0,
                    "item_id": "assessment_conditions-6",
                    "parent_bullet_item_id": "assessment_conditions-5"
                },
                {
                    "text": "applicable documentation including workplace procedures, regulations, codes of practice and operation manuals",
                    "type": "bullet",
                    "order": 7,
                    "indent": 0,
                    "item_id": "assessment_conditions-7",
                    "parent_bullet_item_id": "assessment_conditions-5"
                },
                {
                    "text": "relevant and appropriate materials, tools, equipment and personal protective equipment currently used in industry",
                    "type": "bullet",
                    "order": 8,
                    "indent": 0,
                    "item_id": "assessment_conditions-8",
                    "parent_bullet_item_id": "assessment_conditions-5"
                }
            ],
            "order": 13,
            "table": null,
            "title": "Assessment Conditions"
        }
    ]
