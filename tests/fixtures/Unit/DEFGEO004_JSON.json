        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 6,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Circumstances requiring the provision of advice for operations capabilities are observed, received and clarified in accordance with Australian Defence Force (ADF) regulatory requirements, organisational policy and Standard Operational Procedures (SOPs)"
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Issues relating to operations capabilities are identified and confirmed through effective consultation with relevant personnel in accordance with SOPs"
                            },
                            {
                                "id": "criteria-1_3",
                                "text": "1.3 Issues are interpreted and analysed to determine the circumstances in accordance with SOPs"
                            },
                            {
                                "id": "criteria-1_4",
                                "text": "1.4 Research of relevant documents and literature is conducted in relation to identified issues and unclear findings are clarified with relevant personnel in accordance with SOPs"
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Identify and analyse issues"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Options are identified and evaluated relating to the provision of current and potential future geospatial capability advice in accordance with SOPs"
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Options are prioritised and preferred geospatial capability option is selected in accordance with SOPs"
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Formulate options"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Advice is formulated and discussed with stakeholders in accordance with SOPs"
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Stakeholder requirements are negotiated, incorporated and documented within the proposed advice in accordance with SOPs"
                            },
                            {
                                "id": "criteria-3_3",
                                "text": "3.3 Reports are prepared for concluded advice within specified time and budget in accordance with SOPs"
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Provide advice"
                    }
                ],
                "order": null,
                "columns": [
                    "Element",
                    "Performance Criteria"
                ]
            },
            "title": "Elements and Performance Criteria"
        },
