        {
            "key": "application",
            "items": [
                {
                    "text": "This unit describes the skills required to provide geospatial technical advice related to geospatial capabilities within a Defence environment. The geospatial capabilities include current and future capability options and are related to current and future Defence operations and training.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "application-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "This unit was developed for Defence personnel in a geospatial workplace but may be relevant to others who work in this field.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "application-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Those undertaking this unit would work independently or as part of a team, under indirect supervision while performing complex tasks, in a small range of familiar contexts. They would use discretion and judgement and take responsibility for the quality of their outputs.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "application-3",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Licensing/Regulatory Information",
                    "type": "paragraph",
                    "order": 4,
                    "indent": null,
                    "item_id": "application-4",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "No licensing, legislative or certification requirements apply to unit at the time of publication.",
                    "type": "paragraph",
                    "order": 5,
                    "indent": null,
                    "item_id": "application-5",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 2,
            "table": null,
            "title": "Application"
        },
