        {
            "key": "performance_evidence",
            "items": [
                {
                    "text": "The candidate must show evidence of the ability to complete tasks outlined in elements and performance criteria of this unit, manage tasks and manage contingencies in the context of the job role. There must be evidence that the candidate has:",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "performance_evidence-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "worked with 3 clients to:",
                    "type": "bullet",
                    "order": 2,
                    "indent": 0,
                    "item_id": "performance_evidence-2",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "gather and record detailed information using appropriate assessment methods",
                    "type": "bullet",
                    "order": 3,
                    "indent": 1,
                    "item_id": "performance_evidence-3",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "participate in the design of their programs and documented the program plans",
                    "type": "bullet",
                    "order": 4,
                    "indent": 1,
                    "item_id": "performance_evidence-4",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "implement the programs according to the plan or instructions",
                    "type": "bullet",
                    "order": 5,
                    "indent": 1,
                    "item_id": "performance_evidence-5",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "monitor and evaluate the program plans",
                    "type": "bullet",
                    "order": 6,
                    "indent": 1,
                    "item_id": "performance_evidence-6",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "performed the activities outlined in the performance criteria of this unit during a period of at least 120 hours of work",
                    "type": "bullet",
                    "order": 7,
                    "indent": 0,
                    "item_id": "performance_evidence-7",
                    "parent_bullet_item_id": "performance_evidence-1"
                }
            ],
            "order": 7,
            "table": null,
            "title": "Performance Evidence"
        },
        {
            "key": "knowledge_evidence",
            "items": [
                {
                    "text": "The candidate must be able to demonstrate essential knowledge required to effectively complete tasks outlined in elements and performance criteria of this unit, manage tasks and manage contingencies in the context of the work role. This includes knowledge of:",
