        {
            "key": "application",
            "items": [
                {
                    "text": "This unit describes the skills and knowledge required to participate in planning, implementation and evaluation of programs providing activities for individuals.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "application-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "This unit applies to workers in a range of community services and health contexts who provide leisure and health services.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "application-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "The skills in this unit must be applied in accordance with Commonwealth and State/Territory legislation, Australian/New Zealand standards and industry codes of practice.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "application-3",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 2,
            "table": null,
            "title": "Application"
        },
        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 3,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Use appropriate methods to assess client’s leisure and health needs according to specific purpose and under the guidance of an experienced worker"
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Use a variety of appropriate recording methods under the guidance of an experienced worker"
                            },
                            {
                                "id": "criteria-1_3",
                                "text": "1.3 Record information using holistic approach to health and well being of clients"
                            },
                            {
                                "id": "criteria-1_4",
                                "text": "1.4 Participate in the analysis of information gained to identify individual strengths, needs, interests and preferences"
                            },
                            {
                                "id": "criteria-1_5",
                                "text": "1.5 Maintain confidentiality while observing and recording"
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Gather and record detailed information about clients"
                    },
                    {
                        "criteria": [],
                        "element_id": "element-2",
                        "element_text": "2"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Use a consultative approach based on the client’s leisure and health needs assessment"
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Identify and include a range of resources and ideas to meet the client’s leisure needs based on lifestyle, interests, and social context relevant to the individual and their community"
                            },
                            {
                                "id": "criteria-2_3",
                                "text": "2.3 Identify and include ways in which the health, well being and abilities of individuals are enhanced"
                            },
                            {
                                "id": "criteria-2_4",
                                "text": "2.4 Incorporate the additional and specific leisure and recreation needs of clients while reflecting the philosophy and goals of the service"
                            },
                            {
                                "id": "criteria-2_5",
                                "text": "2.5 Assist with the documentation of an individual program plan for clients based on information gathered during assessment"
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Participate in the design of individual program plans"
                    },
                    {
                        "criteria": [],
                        "element_id": "element-4",
                        "element_text": "4"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Contribute to developing the setting and environment for leisure and health activities within constraints of resources, location and client’s needs and availability"
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Contribute to developing timetables that provide structure and flexibility and serve as a communication tool"
                            },
                            {
                                "id": "criteria-3_3",
                                "text": "3.3 Implement programs, allowing for clear staff communication, adapting to conditions and needs on day, in line with role and service requirements"
                            },
                            {
                                "id": "criteria-3_4",
                                "text": "3.4 Gather and organise resources required for the individual program plan"
                            },
                            {
                                "id": "criteria-3_5",
                                "text": "3.5 Organise off-site outings as extension of program where appropriate, according to directions"
                            },
                            {
                                "id": "criteria-3_6",
                                "text": "3.6 Maintain ongoing communication with those involved in the program"
                            },
                            {
                                "id": "criteria-3_7",
                                "text": "3.7 Identify concerns about current individual program plans and refer appropriately"
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Implement individual program plans"
                    },
                    {
                        "criteria": [],
                        "element_id": "element-6",
                        "element_text": "6"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-4_1",
                                "text": "4.1 Assess progress of each individual using specified processes"
                            },
                            {
                                "id": "criteria-4_2",
                                "text": "4.2 Contribute to regular review of the individual program plan"
                            },
                            {
                                "id": "criteria-4_3",
                                "text": "4.3 Regularly document and evaluate individual program plan outcomes according to individual needs and service requirements"
                            },
                            {
                                "id": "criteria-4_4",
                                "text": "4.4 Clearly identify criteria for documentation and evaluation and use for review"
                            }
                        ],
                        "element_id": "element-4",
                        "element_text": "4 Monitor and evaluate individual program plans"
                    }
                ],
                "order": null,
                "columns": [
                    "Element",
                    "Performance Criteria"
                ]
            },
            "title": "Elements and Performance Criteria"
        },
