        {
            "key": "assessment_conditions",
            "items": [
                {
                    "text": "Assessors must meet the requirements for assessors contained in the Standards for Registered Training Organisations.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "assessment_conditions-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Assessment can be undertaken in the workplace or in a simulated workplace environment.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "assessment_conditions-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "A simulated environment is one that realistically replicates workplace conditions, materials and equipment, interactions with others and workplace irregularities, and which meets industry standards for safety and environmental practices.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "assessment_conditions-3",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "Candidates must have access to:",
                    "type": "paragraph",
                    "order": 4,
                    "indent": null,
                    "item_id": "assessment_conditions-4",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "current construction drawings and specifications",
                    "type": "bullet",
                    "order": 5,
                    "indent": 0,
                    "item_id": "assessment_conditions-5",
                    "parent_bullet_item_id": "assessment_conditions-4"
                },
                {
                    "text": "relevant organisational policies and procedures",
                    "type": "bullet",
                    "order": 6,
                    "indent": 0,
                    "item_id": "assessment_conditions-6",
                    "parent_bullet_item_id": "assessment_conditions-4"
                },
                {
                    "text": "various construction industry contracts",
                    "type": "bullet",
                    "order": 7,
                    "indent": 0,
                    "item_id": "assessment_conditions-7",
                    "parent_bullet_item_id": "assessment_conditions-4"
                },
                {
                    "text": "organisational policies and procedures and other quality documentation required to undertake the performance criteria and assessment requirements",
                    "type": "bullet",
                    "order": 8,
                    "indent": 0,
                    "item_id": "assessment_conditions-8",
                    "parent_bullet_item_id": "assessment_conditions-4"
                },
                {
                    "text": "digital devices, applications and software to set up electronic call forward sheets, compile site files and create channels of communication with internal and external stakeholders.",
                    "type": "bullet",
                    "order": 9,
