        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 9,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Check conditions of approval from local government and regulatory bodies and project commencement dates."
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Identify variations to scope of works and contractual terms and arrangements by the client."
                            },
                            {
                                "id": "criteria-1_3",
                                "text": "1.3 Compile a list of nominated and approved suppliers and contractors and develop channels for effective communication."
                            },
                            {
                                "id": "criteria-1_4",
                                "text": "1.4 Confirm availability of materials with suppliers and labour with contractors."
                            },
                            {
                                "id": "criteria-1_5",
                                "text": "1.5 Enter critical project information into project schedule."
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Assess physical and human resource requirements."
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Prepare electronic call forward sheet and site files containing necessary site documentation."
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Break down project into stages and tasks and set milestones and timeframes for commencement and completion."
                            },
                            {
                                "id": "criteria-2_3",
                                "text": "2.3 Itemise materials and labour required for the stages of construction."
                            },
                            {
                                "id": "criteria-2_4",
                                "text": "2.4 Sequence material delivery dates and commencement times for labour."
                            },
                            {
                                "id": "criteria-2_5",
                                "text": "2.5 Factor in unplanned delays."
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Produce schedules."
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Monitor construction stage progression costs and approved variation costs against estimated project cost."
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Manage and monitor project progress against scheduled timelines."
                            },
                            {
                                "id": "criteria-3_3",
                                "text": "3.3 Record unscheduled and approved variations, changes to the approved plan and specifications and delays to the project."
                            },
                            {
                                "id": "criteria-3_4",
                                "text": "3.4 Resolve issues, within scope of responsibilities, and maintain a cost analysis against final estimated project cost."
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Monitor project costs and maintain project files."
                    }
                ],
                "order": null,
                "columns": [
                    "Element",
                    "Performance Criteria"
                ]
            },
            "title": "Elements and Performance Criteria"
        },
