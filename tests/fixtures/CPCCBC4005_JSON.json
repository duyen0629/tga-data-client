        {
            "key": "performance_evidence",
            "items": [
                {
                    "text": "To demonstrate competency, a candidate must meet the elements and performance criteria of this unit by producing a schedule for the ordering of materials and allocation of labour for a residential or commercial building and construction project.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "performance_evidence-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "In doing this, the candidate must:",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "performance_evidence-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "produce a labour and materials schedule across the life of the project",
                    "type": "bullet",
                    "order": 3,
                    "indent": 0,
                    "item_id": "performance_evidence-3",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "develop and manage efficient communications between staff, contractors and suppliers",
                    "type": "bullet",
                    "order": 4,
                    "indent": 0,
                    "item_id": "performance_evidence-4",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "monitor, maintain and record project progress and variations, estimated and increased costs and changes to construction drawings and specifications.",
                    "type": "bullet",
                    "order": 5,
                    "indent": 0,
                    "item_id": "performance_evidence-5",
                    "parent_bullet_item_id": "performance_evidence-2"
                }
            ],
            "order": 2,
            "table": null,
            "title": "Performance Evidence"
        },
