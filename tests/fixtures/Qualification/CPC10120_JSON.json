      {
        "key": "packaging_rules",
        "items": [
          {
            "text": "To achieve this qualification, the candidate must demonstrate competency in 11 units of competency:",
            "type": "paragraph",
            "order": 1,
            "indent": null,
            "item_id": "packaging_rules-1",
            "parent_bullet_item_id": null
          },
          {
            "text": "8 core units",
            "type": "bullet",
            "order": 2,
            "indent": 0,
            "item_id": "packaging_rules-2",
            "parent_bullet_item_id": "packaging_rules-1"
          },
          {
            "text": "3 elective units.",
            "type": "bullet",
            "order": 3,
            "indent": 0,
            "item_id": "packaging_rules-3",
            "parent_bullet_item_id": "packaging_rules-1"
          },
          {
            "text": "The elective units are to be chosen as follows:",
            "type": "paragraph",
            "order": 4,
            "indent": null,
            "item_id": "packaging_rules-4",
            "parent_bullet_item_id": null
          },
          {
            "text": "up to 3 units from the elective units below",
            "type": "bullet",
            "order": 5,
            "indent": 0,
            "item_id": "packaging_rules-5",
            "parent_bullet_item_id": "packaging_rules-4"
          },
          {
            "text": "one unit from Certificate I or II qualifications in the CPC Training Package or another current Training Package or accredited course, provided the integrity of the AQF alignment is ensured, and it contributes to a valid, industry-supported vocational outcome.",
            "type": "bullet",
            "order": 6,
            "indent": 0,
            "item_id": "packaging_rules-6",
            "parent_bullet_item_id": "packaging_rules-4"
          },
          {
            "text": "Prerequisite units of competency",
            "type": "paragraph",
            "order": 7,
            "indent": null,
            "item_id": "packaging_rules-7",
            "parent_bullet_item_id": null
          },
          {
            "text": "An asterisk (*) against a unit code below indicates that there is a prerequisite requirement that must be met. Prerequisite unit(s) must be assessed before assessment of any unit of competency with an asterisk. Check the unit of competency for information on specific prerequisiterequirements. All prerequisite requirements are packaged in the qualification.",
            "type": "paragraph",
            "order": 8,
            "indent": null,
            "item_id": "packaging_rules-8",
            "parent_bullet_item_id": null
          }
        ],
