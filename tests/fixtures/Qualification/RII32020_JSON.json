      {
        "key": "packaging_rules",
        "items": [
          {
            "text": "The following provides the packaging rules for this qualification, followed by the list of relevant units of competency.",
            "type": "paragraph",
            "order": 1,
            "indent": null,
            "item_id": "packaging_rules-1",
            "parent_bullet_item_id": null
          },
          {
            "text": "Total units = 14",
            "type": "bullet",
            "order": 2,
            "indent": 2,
            "item_id": "packaging_rules-2",
            "parent_bullet_item_id": null
          },
          {
            "text": "10 core units, plus",
            "type": "bullet",
            "order": 3,
            "indent": 1,
            "item_id": "packaging_rules-3",
            "parent_bullet_item_id": null
          },
          {
            "text": "4 elective units, of which:",
            "type": "bullet",
            "order": 4,
            "indent": 1,
            "item_id": "packaging_rules-4",
            "parent_bullet_item_id": null
          },
          {
            "text": "at least two (2) units must be chosen from Group A",
            "type": "bullet",
            "order": 5,
            "indent": 0,
            "item_id": "packaging_rules-5",
            "parent_bullet_item_id": "packaging_rules-1"
          },
          {
            "text": "no more than one (1) unit may be chosen from elsewhere within this training package, or from another endorsed training package or accredited course.",
            "type": "bullet",
            "order": 6,
            "indent": 0,
            "item_id": "packaging_rules-6",
            "parent_bullet_item_id": "packaging_rules-1"
          },
          {
            "text": "All elective units selected from outside this qualification must reflect current occupational and learning outcomes of this AQF qualification level.",
            "type": "paragraph",
            "order": 7,
            "indent": null,
            "item_id": "packaging_rules-7",
            "parent_bullet_item_id": null
          },
          {
            "text": "Where a unit is imported as an elective, care must be taken to ensure that all prerequisites specified are complied with.",
            "type": "paragraph",
            "order": 8,
            "indent": null,
            "item_id": "packaging_rules-8",
            "parent_bullet_item_id": null
          }
        ],
