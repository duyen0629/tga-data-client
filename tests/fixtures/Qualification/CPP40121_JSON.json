          {
            "text": "CPP40121 Certificate IV in Residential Drafting supersedes and is not equivalent to CPP40115 Certificate IV in Building Design Drafting.",
            "type": "paragraph",
            "order": 1,
            "indent": null,
            "item_id": "qualification_mapping_information-1",
            "parent_bullet_item_id": null
          },
          {
            "text": "Qualification title changed to better reflect the occupational outcome.",
            "type": "paragraph",
            "order": 2,
            "indent": null,
            "item_id": "qualification_mapping_information-2",
            "parent_bullet_item_id": null
          },
          {
            "text": "Packaging rules changed with reduction in total number of units. Core requirements strengthened and electives limited to meet industry expectations of competent drafters.",
            "type": "paragraph",
