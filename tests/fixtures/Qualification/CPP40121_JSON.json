    "sections": [
      {
        "key": "modification_history",
        "items": [
          {
            "text": "Release 1",
            "type": "paragraph",
            "order": 1,
            "indent": null,
            "item_id": "modification_history-1",
            "parent_bullet_item_id": null
          },
          {
            "text": "This qualification first released with CPP Property Services Training Package Release 11.0.",
            "type": "paragraph",
            "order": 2,
            "indent": null,
            "item_id": "modification_history-2",
            "parent_bullet_item_id": null
          },
          {
            "text": "Supersedes and is not equivalent to CPP40115 Certificate IV in Building Design Drafting. Qualification title changed to better reflect the occupational outcome. Packaging rules changed with reduction in total number of units. Core requirements strengthened and electives limited to meet industry expectations of competent drafters.",
            "type": "paragraph",
            "order": 3,
            "indent": null,
            "item_id": "modification_history-3",
            "parent_bullet_item_id": null
          }
        ],
        "order": 1,
        "table": null,
        "title": "Modification History"
      },
      {
        "key": "entry_requirements",
        "items": [
          {
            "text": "There are no entry requirements for this qualification.",
            "type": "paragraph",
            "order": 1,
            "indent": null,
            "item_id": "entry_requirements-1",
            "parent_bullet_item_id": null
          }
        ],
        "order": 2,
        "table": null,
        "title": "Entry Requirements"
      },
      {
        "key": "packaging_rules",
        "items": [
          {
            "text": "To achieve this qualification, competency must be demonstrated in 10 units of competency, consisting of 7 core and 3 elective units. Electives are to be chosen as follows:",
            "type": "paragraph",
            "order": 1,
            "indent": null,
            "item_id": "packaging_rules-1",
            "parent_bullet_item_id": null
          },
          {
            "text": "all three units from the electives listed below, or",
            "type": "bullet",
            "order": 2,
            "indent": 0,
            "item_id": "packaging_rules-2",
            "parent_bullet_item_id": "packaging_rules-1"
          },
          {
            "text": "two units from the electives listed below, plus one unit selected from:",
            "type": "bullet",
            "order": 3,
            "indent": 0,
            "item_id": "packaging_rules-3",
            "parent_bullet_item_id": "packaging_rules-1"
          },
          {
            "text": "the CPP50921 Diploma of Building Design qualification, or",
            "type": "bullet",
            "order": 4,
            "indent": 1,
            "item_id": "packaging_rules-4",
            "parent_bullet_item_id": "packaging_rules-3"
          },
          {
            "text": "any current AQF level 4 qualification or accredited course provided it contributes to a valid, industry-supported vocational outcome and does not duplicate the outcome of another unit used to achieve this qualification.",
            "type": "bullet",
            "order": 5,
            "indent": 1,
            "item_id": "packaging_rules-5",
            "parent_bullet_item_id": "packaging_rules-3"
          }
        ],
