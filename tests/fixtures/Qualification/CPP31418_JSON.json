      {
        "key": "packaging_rules",
        "items": [
          {
            "text": "To achieve this qualification, competency must be demonstrated in:",
            "type": "paragraph",
            "order": 1,
            "indent": null,
            "item_id": "packaging_rules-1",
            "parent_bullet_item_id": null
          },
          {
            "text": "14 units of competency:",
            "type": "bullet",
            "order": 2,
            "indent": 0,
            "item_id": "packaging_rules-2",
            "parent_bullet_item_id": "packaging_rules-1"
          },
          {
            "text": "8 core units",
            "type": "bullet",
            "order": 3,
            "indent": 1,
            "item_id": "packaging_rules-3",
            "parent_bullet_item_id": "packaging_rules-2"
          },
          {
            "text": "6 elective units.",
            "type": "bullet",
            "order": 4,
            "indent": 1,
            "item_id": "packaging_rules-4",
            "parent_bullet_item_id": "packaging_rules-2"
          },
          {
            "text": "The elective units must ensure the integrity of the AQF alignment and contribute to a valid, industry-supported vocational outcome and are to be chosen as follows:",
            "type": "paragraph",
            "order": 5,
            "indent": null,
            "item_id": "packaging_rules-5",
            "parent_bullet_item_id": null
          },
          {
            "text": "a minimum of 4 elective units must be chosen from the elective units listed below",
            "type": "bullet",
            "order": 6,
            "indent": 0,
            "item_id": "packaging_rules-6",
            "parent_bullet_item_id": "packaging_rules-5"
          },
          {
            "text": "up to 2 units may be chosen from the elective units listed below, or elsewhere from the CPP Property Services Training Package or other current Training Packages.",
            "type": "bullet",
            "order": 7,
            "indent": 0,
            "item_id": "packaging_rules-7",
            "parent_bullet_item_id": "packaging_rules-5"
          },
          {
            "text": "Electives selected from outside this qualification must be relevant to the occupational outcome.",
            "type": "paragraph",
            "order": 8,
            "indent": null,
            "item_id": "packaging_rules-8",
            "parent_bullet_item_id": null
          },
          {
            "text": "An asterisk against a unit code listed below indicates that there is a prerequisite.",
            "type": "paragraph",
            "order": 9,
            "indent": null,
            "item_id": "packaging_rules-9",
            "parent_bullet_item_id": null
          }
        ],
        "order": 3,
