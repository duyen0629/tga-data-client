      {
        "key": "packaging_rules",
        "items": [
          {
            "text": "To achieve this qualification, the candidate must demonstrate competency in:",
            "type": "paragraph",
            "order": 1,
            "indent": null,
            "item_id": "packaging_rules-1",
            "parent_bullet_item_id": null
          },
          {
            "text": "15 units of competency:",
            "type": "bullet",
            "order": 2,
            "indent": 0,
            "item_id": "packaging_rules-2",
            "parent_bullet_item_id": "packaging_rules-1"
          },
          {
            "text": "8 core units",
            "type": "bullet",
            "order": 3,
            "indent": 1,
            "item_id": "packaging_rules-3",
            "parent_bullet_item_id": "packaging_rules-2"
          },
          {
            "text": "7 elective units.",
            "type": "bullet",
            "order": 4,
            "indent": 1,
            "item_id": "packaging_rules-4",
            "parent_bullet_item_id": "packaging_rules-2"
          },
          {
            "text": "Elective units are to be selected as follows:",
            "type": "paragraph",
            "order": 5,
            "indent": null,
            "item_id": "packaging_rules-5",
            "parent_bullet_item_id": null
          },
          {
            "text": "all 7 elective units can be selected from the electives below",
            "type": "bullet",
            "order": 6,
            "indent": 0,
            "item_id": "packaging_rules-6",
            "parent_bullet_item_id": "packaging_rules-5"
          },
          {
            "text": "up to 2 units can be selected from any training package or accredited course, as long as they contribute to a valid, industry-supported vocational outcome and supports the AQF level of this qualification.",
            "type": "bullet",
            "order": 7,
            "indent": 0,
            "item_id": "packaging_rules-7",
            "parent_bullet_item_id": "packaging_rules-5"
          },
          {
            "text": "Prerequisite units of competency",
            "type": "paragraph",
            "order": 8,
            "indent": null,
            "item_id": "packaging_rules-8",
            "parent_bullet_item_id": null
          },
          {
            "text": "An asterisk (*) against a unit code below indicates that there is a prerequisite requirement that must be met. Prerequisite unit/s must be assessed before assessment of any unit of competency with an asterisk. All prerequisite requirements are packaged in the qualification.",
            "type": "paragraph",
            "order": 9,
            "indent": null,
            "item_id": "packaging_rules-9",
            "parent_bullet_item_id": null
          }
        ],
