    {
      "key": "packaging_rules",
      "items": [
        {
          "text": "Total number of units = 36",
          "type": "bullet",
          "order": 1,
          "indent": 2,
          "item_id": "packaging_rules-1",
          "parent_bullet_item_id": null
        },
        {
          "text": "22core units, plus",
          "type": "paragraph",
          "order": 2,
          "indent": null,
          "item_id": "packaging_rules-2",
          "parent_bullet_item_id": null
        },
        {
          "text": "14elective units, of which:",
          "type": "paragraph",
          "order": 3,
          "indent": null,
          "item_id": "packaging_rules-3",
          "parent_bullet_item_id": null
        },
        {
          "text": "1 unit must be from one of the Specialist Elective Groups A or B below",
          "type": "bullet",
          "order": 4,
          "indent": 0,
          "item_id": "packaging_rules-4",
          "parent_bullet_item_id": "packaging_rules-3"
        },
        {
          "text": "of the remaining 13 units required to make up the elective unit total:",
          "type": "bullet",
          "order": 5,
          "indent": 0,
          "item_id": "packaging_rules-5",
          "parent_bullet_item_id": "packaging_rules-3"
        },
        {
          "text": "up to 13 may be from the Specialist Elective Groups and/or the general elective units listed below",
          "type": "bullet",
          "order": 6,
          "indent": 1,
          "item_id": "packaging_rules-6",
          "parent_bullet_item_id": "packaging_rules-5"
        },
        {
          "text": "up to 6 may be from a Certificate II qualification or above in this Training Package or another endorsed Training Package or accredited course.",
          "type": "bullet",
          "order": 7,
          "indent": 1,
          "item_id": "packaging_rules-7",
          "parent_bullet_item_id": "packaging_rules-5"
        },
        {
          "text": "Elective units chosen must be relevant to the work environment and the qualification, maintain the overall integrity of the AQF alignment, not duplicate the outcome of another unit chosen for the qualification, and contribute to a valid vocational outcome.",
          "type": "paragraph",
          "order": 8,
          "indent": null,
          "item_id": "packaging_rules-8",
          "parent_bullet_item_id": null
        },
