    {
      "key": "packaging_rules",
      "items": [
        {
          "text": "Total number of units = 10",
          "type": "paragraph",
          "order": 1,
          "indent": null,
          "item_id": "packaging_rules-1",
          "parent_bullet_item_id": null
        },
        {
          "text": "5 core units plus",
          "type": "paragraph",
          "order": 2,
          "indent": null,
          "item_id": "packaging_rules-2",
          "parent_bullet_item_id": null
        },
        {
          "text": "5 elective units, of which:",
          "type": "paragraph",
          "order": 3,
          "indent": null,
          "item_id": "packaging_rules-3",
          "parent_bullet_item_id": null
        },
        {
          "text": "3 units must be from Group A below",
          "type": "bullet",
          "order": 4,
          "indent": 0,
          "item_id": "packaging_rules-4",
          "parent_bullet_item_id": "packaging_rules-3"
        },
        {
          "text": "the remaining 2 units may be selected as follows:",
          "type": "bullet",
          "order": 5,
          "indent": 0,
          "item_id": "packaging_rules-5",
          "parent_bullet_item_id": "packaging_rules-3"
        },
        {
          "text": "both may be selected from Group A, Group B or any currently endorsed Training Package qualification or accredited course at the same Australian Qualifications Framework (AQF) level",
          "type": "bullet",
          "order": 6,
          "indent": 1,
          "item_id": "packaging_rules-6",
          "parent_bullet_item_id": "packaging_rules-5"
        },
        {
          "text": "1 may be selected from a Certificate III or Diploma, from any currently endorsed Training Package qualification or accredited course.",
          "type": "bullet",
          "order": 7,
          "indent": 1,
          "item_id": "packaging_rules-7",
          "parent_bullet_item_id": "packaging_rules-5"
        },
        {
          "text": "Elective units must be relevant to the work environment and the qualification, maintain the integrity of the AQF alignment and contribute to a valid, industry-supported vocational outcome.",
          "type": "paragraph",
          "order": 8,
          "indent": null,
          "item_id": "packaging_rules-8",
          "parent_bullet_item_id": null
        },
