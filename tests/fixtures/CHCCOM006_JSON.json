        {
            "key": "application",
            "items": [
                {
                    "text": "This unit describes the skills and knowledge to establish and manage professional one-to-one relationships with clients in the context of providing an ongoing health service or intervention.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "application-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "This unit applies to community services or health workers who have defined responsibilities to work independently with clients within broad but established guidelines.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "application-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "The skills in this unit must be applied in accordance with Commonwealth and State/Territory legislation, Australian/New Zealand standards and industry codes of practice.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "application-3",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 6,
            "table": null,
            "title": "Application"
        },
        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 7,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Performance criteria specify the performance needed to demonstrate achievement of the element"
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Elements define the essential outcomes"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Establish relationship within appropriate professional boundaries"
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Build trust and respect through use of effective communication techniques"
                            },
                            {
                                "id": "criteria-1_3",
                                "text": "1.3 Identify and respond to client special needs"
                            },
                            {
                                "id": "criteria-1_4",
                                "text": "1.4 Communicate in ways that take account of cultural considerations"
                            },
                            {
                                "id": "criteria-1_5",
                                "text": "1.5 Exercise discretion and confidentiality"
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Establish professional relationship with the client"
                    },
                    {
                        "criteria": [],
                        "element_id": "element-3",
                        "element_text": "3"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Use a collaborative and person centred approach when working with clients"
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Use motivational interviewing as a basis for client interactions"
                            },
                            {
                                "id": "criteria-2_3",
                                "text": "2.3 Seek client information respectfully and sensitively, using purposeful, systematic and diplomatic questions"
                            },
                            {
                                "id": "criteria-2_4",
                                "text": "2.4 Support the client to identify and articulate key information that supports the provision of service"
                            },
                            {
                                "id": "criteria-2_5",
                                "text": "2.5 Encourage clients to voice queries or concerns and address these appropriately"
                            },
                            {
                                "id": "criteria-2_6",
                                "text": "2.6 Respond to difficult or challenging behaviour using established techniques"
                            },
                            {
                                "id": "criteria-2_7",
                                "text": "2.7 Maintain professional integrity and boundaries at all times"
                            },
                            {
                                "id": "criteria-2_8",
                                "text": "2.8 Work within scope of role and identify and respond to situations where interactions suggest the need for client referral"
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Manage client interactions"
                    },
                    {
                        "criteria": [],
                        "element_id": "element-5",
                        "element_text": "5"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Select the most appropriate mode of communication for the information being provided"
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Use language and terminology that the client will understand"
                            },
                            {
                                "id": "criteria-3_3",
                                "text": "3.3 Present information clearly and with sufficient detail to meet client needs"
                            },
                            {
                                "id": "criteria-3_4",
                                "text": "3.4 Confirm with client that the information has been understood and address any unresolved issues"
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Provide effective responses to client enquiries"
                    }
                ],
                "order": null,
                "columns": [
                    "Element",
                    "Performance Criteria"
                ]
            },
            "title": "Elements and Performance Criteria"
        },
        {
            "key": "foundation_skills",
            "items": [
