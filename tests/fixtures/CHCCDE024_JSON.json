        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 6,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Plan and implement opportunities for stakeholders to identify and advance community priorities and aspirations."
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Identify models of participation and action research methods."
                            },
                            {
                                "id": "criteria-1_3",
                                "text": "1.3 Identify, develop and agree on strategies for meeting community priorities."
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Respond to community priorities."
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Assess suitability of activities proposed to address community priorities."
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Determine amount and type of resources required to undertake proposed activities and assist in securing access to resources."
                            },
                            {
                                "id": "criteria-2_3",
                                "text": "2.3 Support community and stakeholders to undertake advocacy and lobbying activities."
                            },
                            {
                                "id": "criteria-2_4",
                                "text": "2.4 Facilitate collaboration and cooperation between community stakeholders."
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Support identified community priorities."
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Evaluate the effectiveness of activities in meeting community priorities using accepted strategies and mechanisms."
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Review progress of strategies with key stakeholders and update as required to ensure strategies continue to support community priorities."
                            },
                            {
                                "id": "criteria-3_3",
                                "text": "3.3 Document outcomes of evaluations and report according to organisational policies and procedures."
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Evaluate effectiveness of community action."
                    }
                ],
                "order": null,
                "columns": [
                    "Element",
                    "Performance Criteria"
                ]
            },
            "title": "Elements and Performance Criteria"
        },
