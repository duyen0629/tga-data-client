        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 5,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Access and maintain current information about the industry and workplace, and apply within daily activities"
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Document roles, needs and expectations of key internal and external stakeholders"
                            },
                            {
                                "id": "criteria-1_3",
                                "text": "1.3 Identify sources of assistance in undertaking own work role"
                            },
                            {
                                "id": "criteria-1_4",
                                "text": "1.4 Follow workplace policies and procedures to carry out work tasks effectively"
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Obtain and use industry information"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Identify legislation and regulations relevant to the organisation and workplace activities"
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Identify and document key principles contained in legislation and regulations"
                            },
                            {
                                "id": "criteria-2_3",
                                "text": "2.3 Confirm statutory powers provided under legislation and the boundaries of those powers"
                            },
                            {
                                "id": "criteria-2_4",
                                "text": "2.4 Enforce legislation as required within day-to-day work activities"
                            },
                            {
                                "id": "criteria-2_5",
                                "text": "2.5 Work within the boundaries and powers contained in animal management legislation and workplace requirements"
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Review and implement relevant animal management legislative and regulatory requirements"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Access a workplace information management system"
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Enter new or amend existing records accurately in a workplace management system"
                            },
                            {
                                "id": "criteria-3_3",
                                "text": "3.3 Complete and store records according to workplace policies and procedures and legislative requirements"
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Maintain records"
                    }
                ],
                "order": null,
                "columns": [
                    "Element",
                    "Performance Criteria"
                ]
            },
            "title": "Elements and Performance Criteria"
