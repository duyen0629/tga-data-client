        {
            "key": "performance_evidence",
            "items": [
                {
                    "text": "An individual demonstrating competency must satisfy all of the elements and performance criteria in this unit.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "performance_evidence-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "There must be evidence that the individual has:",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "performance_evidence-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "summarised the key principles and statutory powers contained within legislation and regulations relevant to work undertaken in the animal management and regulation workplace",
                    "type": "bullet",
                    "order": 3,
                    "indent": 0,
                    "item_id": "performance_evidence-3",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "applied relevant legislation and workplace information to complete at least three day-to-day work activities, including at least one serious breach of compliance involving an animal",
                    "type": "bullet",
                    "order": 4,
                    "indent": 0,
                    "item_id": "performance_evidence-4",
                    "parent_bullet_item_id": "performance_evidence-2"
                },
                {
                    "text": "used workplace information management system to access existing records, accurately create or update records, and store according to workplace and legislative requirements on at least three occasions.",
                    "type": "bullet",
                    "order": 5,
                    "indent": 0,
                    "item_id": "performance_evidence-5",
                    "parent_bullet_item_id": "performance_evidence-2"
                }
            ],
            "order": 9,
            "table": null,
            "title": "Performance Evidence"
        },
        {
            "key": "knowledge_evidence",
            "items": [
                {
                    "text": "An individual must be able to demonstrate the knowledge required to perform the tasks outlined in the elements and performance criteria of this unit. This includes knowledge of:",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "knowledge_evidence-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "enabling Commonwealth, state/territory and local government legislation, regulations, standards and codes of practice relevant to an animal regulation and management environment",
                    "type": "bullet",
                    "order": 2,
                    "indent": 0,
                    "item_id": "knowledge_evidence-2",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "workplace policies and procedures relevant to animal management and regulation",
                    "type": "bullet",
                    "order": 3,
                    "indent": 0,
                    "item_id": "knowledge_evidence-3",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "workplace organisational and reporting structure for animal management and regulation",
                    "type": "bullet",
                    "order": 4,
                    "indent": 0,
                    "item_id": "knowledge_evidence-4",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "key internal and external stakeholders",
                    "type": "bullet",
                    "order": 5,
                    "indent": 0,
                    "item_id": "knowledge_evidence-5",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "features of workplace management system, including operations and record-keeping requirements.",
                    "type": "bullet",
                    "order": 6,
                    "indent": 0,
                    "item_id": "knowledge_evidence-6",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                }
            ],
            "order": 10,
            "table": null,
            "title": "Knowledge Evidence"
        },
        {
            "key": "assessment_conditions",
            "items": [
                {
                    "text": "Assessment of the skills in this unit of competency must take place under the following conditions:",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "assessment_conditions-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "physical conditions:",
                    "type": "bullet",
                    "order": 2,
                    "indent": 0,
                    "item_id": "assessment_conditions-2",
                    "parent_bullet_item_id": "assessment_conditions-1"
                },
                {
                    "text": "a workplace or an environment that accurately represents workplace conditions",
                    "type": "bullet",
                    "order": 3,
                    "indent": 1,
                    "item_id": "assessment_conditions-3",
                    "parent_bullet_item_id": "assessment_conditions-2"
                },
                {
                    "text": "resources, equipment and materials:",
                    "type": "bullet",
                    "order": 4,
                    "indent": 0,
                    "item_id": "assessment_conditions-4",
                    "parent_bullet_item_id": "assessment_conditions-1"
                },
                {
                    "text": "equipment and/or resources necessary to complete tasks in an animal management and regulatory environment",
                    "type": "bullet",
                    "order": 5,
                    "indent": 1,
                    "item_id": "assessment_conditions-5",
                    "parent_bullet_item_id": "assessment_conditions-4"
                },
                {
                    "text": "workplace information management or record-keeping system",
                    "type": "bullet",
                    "order": 6,
                    "indent": 1,
                    "item_id": "assessment_conditions-6",
                    "parent_bullet_item_id": "assessment_conditions-4"
                },
                {
                    "text": "specifications:",
                    "type": "bullet",
                    "order": 7,
                    "indent": 0,
                    "item_id": "assessment_conditions-7",
                    "parent_bullet_item_id": "assessment_conditions-1"
                },
                {
                    "text": "access to relevant animal management legislation, regulations and workplace documentation.",
                    "type": "bullet",
                    "order": 8,
                    "indent": 1,
                    "item_id": "assessment_conditions-8",
                    "parent_bullet_item_id": "assessment_conditions-7"
                },
                {
                    "text": "Assessors of this unit must satisfy the requirements for assessors in applicable vocational education and training legislation, frameworks and/or standards.",
                    "type": "paragraph",
                    "order": 9,
                    "indent": null,
                    "item_id": "assessment_conditions-9",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 11,
            "table": null,
            "title": "Assessment Conditions"
        }
