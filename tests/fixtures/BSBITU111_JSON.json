        {
            "key": "performance_evidence",
            "items": [
                {
                    "text": "Evidence of the ability to:",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "performance_evidence-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "follow user procedures to activate and access a personal digital device",
                    "type": "bullet",
                    "order": 2,
                    "indent": 0,
                    "item_id": "performance_evidence-2",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "follow user procedures and system information when using the basic functions on a personal digital device, seeking assistance when necessary",
                    "type": "bullet",
                    "order": 3,
                    "indent": 0,
                    "item_id": "performance_evidence-3",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "use desktop or menu icons and create shortcuts",
                    "type": "bullet",
                    "order": 4,
                    "indent": 0,
                    "item_id": "performance_evidence-4",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "create and manipulate folders and subfolders",
                    "type": "bullet",
                    "order": 5,
                    "indent": 0,
                    "item_id": "performance_evidence-5",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "update and save changes to files, documents, applications, or similar",
                    "type": "bullet",
                    "order": 6,
                    "indent": 0,
                    "item_id": "performance_evidence-6",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "correctly shut down or deactivate applications and the device.",
                    "type": "bullet",
                    "order": 7,
                    "indent": 0,
                    "item_id": "performance_evidence-7",
                    "parent_bullet_item_id": "performance_evidence-1"
                },
                {
                    "text": "Note: If a specific volume or frequency is not stated, then evidence must be provided at least once.",
                    "type": "paragraph",
                    "order": 8,
                    "indent": null,
                    "item_id": "performance_evidence-8",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 2,
            "table": null,
            "title": "Performance Evidence"
        },
        {
            "key": "knowledge_evidence",
            "items": [
                {
                    "text": "The candidate must be able to demonstrate the following knowledge to effectively complete the tasks outlined in the elements and performance criteria of this unit, and to manage tasks and reasonably foreseeable contingencies in the context of the work role.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "knowledge_evidence-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "User procedures for activating and accessing a personal digital device",
                    "type": "bullet",
                    "order": 2,
                    "indent": 0,
                    "item_id": "knowledge_evidence-2",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "Key components of the digital system, including what each one does",
                    "type": "bullet",
                    "order": 3,
                    "indent": 0,
                    "item_id": "knowledge_evidence-3",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "Key functions of the operating system",
                    "type": "bullet",
                    "order": 4,
                    "indent": 0,
                    "item_id": "knowledge_evidence-4",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                },
                {
                    "text": "Organisational conventions for naming files",
                    "type": "bullet",
                    "order": 5,
                    "indent": 0,
                    "item_id": "knowledge_evidence-5",
                    "parent_bullet_item_id": "knowledge_evidence-1"
                }
            ],
            "order": 3,
            "table": null,
            "title": "Knowledge Evidence"
        },
        {
            "key": "assessment_conditions",
            "items": [
                {
                    "text": "Assessment must be conducted in a safe environment where evidence gathered demonstrates consistent performance of typical activities experienced in the information and communications technology – IT use field of work and include access to:",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "assessment_conditions-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "organisational policies and procedures",
                    "type": "bullet",
                    "order": 2,
                    "indent": 0,
                    "item_id": "assessment_conditions-2",
                    "parent_bullet_item_id": "assessment_conditions-1"
                },
                {
                    "text": "device user and system information",
                    "type": "bullet",
                    "order": 3,
                    "indent": 0,
                    "item_id": "assessment_conditions-3",
                    "parent_bullet_item_id": "assessment_conditions-1"
                },
                {
                    "text": "suitable workspace including a personal digital device.",
                    "type": "bullet",
                    "order": 4,
                    "indent": 0,
                    "item_id": "assessment_conditions-4",
                    "parent_bullet_item_id": "assessment_conditions-1"
                },
                {
                    "text": "Assessors of this unit must satisfy the assessor requirements in applicable vocational education and training legislation, frameworks and/or standards.",
                    "type": "paragraph",
                    "order": 5,
                    "indent": null,
                    "item_id": "assessment_conditions-5",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 4,
            "table": null,
            "title": "Assessment Conditions"
        },
