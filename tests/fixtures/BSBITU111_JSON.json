        {
            "key": "application",
            "items": [
                {
                    "text": "This unit describes the skills and knowledge required to start up and use a range of basic functions on a personal digital device.",
                    "type": "paragraph",
                    "order": 1,
                    "indent": null,
                    "item_id": "application-1",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "It applies to individuals who perform a range of routine digital tasks in the various sectors of the business services industry and generally work under direct supervision.",
                    "type": "paragraph",
                    "order": 2,
                    "indent": null,
                    "item_id": "application-2",
                    "parent_bullet_item_id": null
                },
                {
                    "text": "No licensing, legislative or certification requirements apply to this unit at the time of publication.",
                    "type": "paragraph",
                    "order": 3,
                    "indent": null,
                    "item_id": "application-3",
                    "parent_bullet_item_id": null
                }
            ],
            "order": 6,
            "table": null,
            "title": "Application"
        },
