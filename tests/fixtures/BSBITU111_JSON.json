        {
            "key": "elements_and_performance_criteria",
            "items": [],
            "order": 8,
            "table": {
                "rows": [
                    {
                        "criteria": [
                            {
                                "id": "criteria-1_1",
                                "text": "1.1 Activate personal digital device, and access or log on according to user procedures"
                            },
                            {
                                "id": "criteria-1_2",
                                "text": "1.2 Identify basic functions and features using system information"
                            },
                            {
                                "id": "criteria-1_3",
                                "text": "1.3 Customise desktop or application configuration, if necessary, with assistance from appropriate persons"
                            },
                            {
                                "id": "criteria-1_4",
                                "text": "1.4 Access help functions as required"
                            }
                        ],
                        "element_id": "element-1",
                        "element_text": "1 Activate personal digital device and access features"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-2_1",
                                "text": "2.1 Open, close and access features by selecting correct desktop or menu icons"
                            },
                            {
                                "id": "criteria-2_2",
                                "text": "2.2 Create shortcuts onto the desktop or menu, if necessary, with assistance from appropriate persons"
                            },
                            {
                                "id": "criteria-2_3",
                                "text": "2.3 Create folders/subfolders of files or applications (or similar) with suitable names for personal device"
                            },
                            {
                                "id": "criteria-2_4",
                                "text": "2.4 Download new applications (or similar), with assistance from appropriate persons"
                            },
                            {
                                "id": "criteria-2_5",
                                "text": "2.5 Rename and move folders/subfolders of files or applications (or similar) with suitable names"
                            },
                            {
                                "id": "criteria-2_6",
                                "text": "2.6 Use search functions to locate files or applications (or similar)"
                            },
                            {
                                "id": "criteria-2_7",
                                "text": "2.7 Remove files or applications (or similar) as required, with assistance from appropriate persons"
                            }
                        ],
                        "element_id": "element-2",
                        "element_text": "2 Navigate and organise file or application environment"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-3_1",
                                "text": "3.1 Open relevant file, document, application, or similar"
                            },
                            {
                                "id": "criteria-3_2",
                                "text": "3.2 Edit content of the file, document, application, or similar in accordance with simple instructions"
                            },
                            {
                                "id": "criteria-3_3",
                                "text": "3.3 Save changes to personal device"
                            }
                        ],
                        "element_id": "element-3",
                        "element_text": "3 Edit stored information"
                    },
                    {
                        "criteria": [
                            {
                                "id": "criteria-4_1",
                                "text": "4.1 Save and close all open applications"
                            },
                            {
                                "id": "criteria-4_2",
                                "text": "4.2 Shut down or deactivate personal digital device according to user procedures"
                            }
                        ],
                        "element_id": "element-4",
                        "element_text": "4 Shut down/deactivate personal digital device"
                    }
                ],
                "order": null,
                "columns": [
                    "Element",
                    "Performance Criteria"
                ]
            },
            "title": "Elements and Performance Criteria"
        },
        {
            "key": "foundation_skills",
            "items": [
