    </appSettings>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="TrainingComponentServiceBasicHttpEndpoint" maxReceivedMessageSize="10485760" maxBufferSize="10485760">
                    <readerQuotas maxDepth="32" maxStringContentLength="10485760" maxArrayLength="10485760" maxBytesPerRead="10485760" maxNameTableCharCount="10485760" />
                    <security mode="TransportWithMessageCredential" />
                </binding>
                <binding name="OrganisationServiceBasicHttpEndpoint" maxReceivedMessageSize="10485760" maxBufferSize="10485760">
                    <readerQuotas maxDepth="32" maxStringContentLength="10485760" maxArrayLength="10485760" maxBytesPerRead="10485760" maxNameTableCharCount="10485760" />
                    <security mode="TransportWithMessageCredential" />
                </binding>
                <binding name="ClassificationServiceBasicHttpEndpoint" maxReceivedMessageSize="10485760" maxBufferSize="10485760">
                    <readerQuotas maxDepth="32" maxStringContentLength="10485760" maxArrayLength="10485760" maxBytesPerRead="10485760" maxNameTableCharCount="10485760" />
                    <security mode="TransportWithMessageCredential" />
                </binding>
            </basicHttpBinding>
            <wsHttpBinding>
                <binding name="TrainingComponentServiceWsHttpEndpoint">
                    <security mode="TransportWithMessageCredential">
                        <transport clientCredentialType="None" />
                        <message clientCredentialType="UserName" establishSecurityContext="false" />
                    </security>
                </binding>
            </wsHttpBinding>
        </bindings>
        <client>
            <endpoint address="https://ws.training.gov.au/Deewr.Tga.WebServices/TrainingComponentService.svc/Training"
                binding="basicHttpBinding" bindingConfiguration="TrainingComponentServiceBasicHttpEndpoint"
                contract="ITrainingComponentService" name="TrainingComponentServiceBasicHttpEndpoint" />
            <endpoint address="https://ws.training.gov.au/Deewr.Tga.WebServices/OrganisationService.svc/Organisation"
                binding="basicHttpBinding" bindingConfiguration="OrganisationServiceBasicHttpEndpoint"
                contract="IOrganisationService" name="OrganisationServiceBasicHttpEndpoint" />
            <endpoint address="https://ws.training.gov.au/Deewr.Tga.WebServices/ClassificationService.svc/Classification"
                binding="basicHttpBinding" bindingConfiguration="ClassificationServiceBasicHttpEndpoint"
                contract="IClassificationService" name="ClassificationServiceBasicHttpEndpoint" />
            <endpoint address="https://ws.training.gov.au/Deewr.Tga.WebServices/TrainingComponentService.svc/Training12"
                binding="wsHttpBinding" bindingConfiguration="TrainingComponentServiceWsHttpEndpoint"
                contract="ITrainingComponentService" name="TrainingComponentServiceWsHttpEndpoint">
                <identity>
                    <dns value="localhost" />
                </identity>
            </endpoint>
        </client>
    </system.serviceModel>
</configuration>
