<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <appSettings>
        <!-- Supabase Configuration -->
        <add key="SupabaseUrl" value="https://pfzfvelwoasovmxvvvgn.supabase.co" />
        <add key="SupabaseKey" value="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBmemZ2ZWx3b2Fzb3ZteHZ2dmduIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjgzNDgxNjQsImV4cCI6MjA4MzkyNDE2NH0.RPcq9_pXJqiu9xZYnpJQ-5rWi-WSnIKPV7KudRwQAEQ" />
        <!-- TGA SOAP (training.gov.au): set production username/password issued for your integration -->
        <add key="TgaSoapUserName" value="ws.onshiftpm2" />
