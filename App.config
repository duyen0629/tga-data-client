<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="TrainingComponentServiceBasicHttpEndpoint">
                    <security mode="TransportWithMessageCredential" />
                </binding>
            </basicHttpBinding>
            <wsHttpBinding>
                <binding name="TrainingComponentServiceWsHttpEndpoint">
                    <security mode="TransportWithMessageCredential">
                        <transport clientCredentialType="None" />
                        <message clientCredentialType="UserName" establishSecurityContext="false" />
                    </security>
                </binding>
            </wsHttpBinding>
        </bindings>
        <client>
            <endpoint address="https://ws.sandbox.training.gov.au/Deewr.Tga.WebServices/TrainingComponentService.svc/Training"
                binding="basicHttpBinding" bindingConfiguration="TrainingComponentServiceBasicHttpEndpoint"
                contract="ITrainingComponentService" name="TrainingComponentServiceBasicHttpEndpoint" />
            <endpoint address="https://ws.sandbox.training.gov.au/Deewr.Tga.WebServices/TrainingComponentService.svc/Training12"
                binding="wsHttpBinding" bindingConfiguration="TrainingComponentServiceWsHttpEndpoint"
                contract="ITrainingComponentService" name="TrainingComponentServiceWsHttpEndpoint">
                <identity>
                    <dns value="localhost" />
                </identity>
            </endpoint>
        </client>
    </system.serviceModel>
</configuration>
